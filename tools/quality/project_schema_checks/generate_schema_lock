#!/usr/bin/env python3
"""Regenerate project_schema_lock.cpp from the two project schema artifacts.

The lock pins every schema node of schemas/project/document-1.0.schema.json and
manifest-1.0.schema.json: its JSON pointer and its own keywords, with subschemas replaced by
markers (member names for `properties` and `$defs`, a count for `oneOf`/`anyOf`/`allOf`, and
"<schema>" for a single subschema). The checker walks the artifacts the same way, so any schema
edit fails until this file is regenerated and the regenerated lock is reviewed with it.

Usage: generate_schema_lock <repository root>
"""

import json
import pathlib
import sys

NAMED_SUBSCHEMAS = ("properties", "$defs")
LISTED_SUBSCHEMAS = ("oneOf", "anyOf", "allOf", "prefixItems")
SINGLE_SUBSCHEMAS = (
    "items",
    "if",
    "then",
    "else",
    "not",
    "contains",
    "propertyNames",
    "additionalProperties",
    "unevaluatedProperties",
    "additionalItems",
    "unevaluatedItems",
)


class Number:
    def __init__(self, spelling):
        self.spelling = spelling


def load(path):
    return json.loads(
        path.read_text(encoding="utf-8"),
        parse_int=Number,
        parse_float=Number,
        object_pairs_hook=dict,
    )


def escape_pointer(key):
    return key.replace("~", "~0").replace("/", "~1")


def shallow(node):
    result = {}
    for key, value in node.items():
        if key in NAMED_SUBSCHEMAS and isinstance(value, dict):
            result[key] = list(value.keys())
        elif key in LISTED_SUBSCHEMAS and isinstance(value, list):
            result[key] = Number(str(len(value)))
        elif key in SINGLE_SUBSCHEMAS and isinstance(value, dict):
            result[key] = "<schema>"
        else:
            result[key] = value
    return result


def children(node, pointer):
    for key, value in node.items():
        if key in NAMED_SUBSCHEMAS and isinstance(value, dict):
            for name, child in value.items():
                yield f"{pointer}/{escape_pointer(key)}/{escape_pointer(name)}", child
        elif key in LISTED_SUBSCHEMAS and isinstance(value, list):
            for index, child in enumerate(value):
                yield f"{pointer}/{key}/{index}", child
        elif key in SINGLE_SUBSCHEMAS and isinstance(value, dict):
            yield f"{pointer}/{key}", value


def visit(node, pointer, pins):
    if not isinstance(node, dict):
        return
    pins.append((pointer, shallow(node)))
    for child_pointer, child in children(node, pointer):
        visit(child, child_pointer, pins)


def encode(value):
    if isinstance(value, Number):
        return value.spelling
    if isinstance(value, dict):
        return "{" + ",".join(f"{encode(k)}:{encode(v)}" for k, v in value.items()) + "}"
    if isinstance(value, list):
        return "[" + ",".join(encode(item) for item in value) + "]"
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=True).replace("\x7f", "\\u007f")
    return json.dumps(value)


def emit(name, pins):
    lines = [f"const std::array<SchemaNodePin, {len(pins)}> {name}{{{{"]
    for pointer, node in pins:
        lines.append(f'    {{"{pointer}", R"pin({encode(node)})pin"}},')
    lines.append("}};")
    return "\n".join(lines)


def main():
    if len(sys.argv) != 2:
        sys.exit("usage: generate_schema_lock <repository root>")
    root = pathlib.Path(sys.argv[1])
    tables = []
    for variable, artifact in (
        ("kDocumentSchemaLock", "document-1.0.schema.json"),
        ("kManifestSchemaLock", "manifest-1.0.schema.json"),
    ):
        pins = []
        visit(load(root / "schemas/project" / artifact), "", pins)
        tables.append(emit(variable, pins))
    output = root / "tools/quality/project_schema_checks/project_schema_lock.cpp"
    output.write_text(
        "// Generated by generate_schema_lock from schemas/project. Regenerate it in the same\n"
        "// change as any schema edit; the reviewed diff of this file is the schema change.\n"
        "// clang-format off\n"
        '#include "schema_check_helpers.hpp"\n\n'
        "#include <array>\n\n"
        "namespace bloom::quality::schema_detail {\n"
        "namespace {\n\n" + "\n\n".join(tables) + "\n\n} // namespace\n\n"
        "auto documentSchemaLock() -> std::span<const SchemaNodePin> { return kDocumentSchemaLock; }\n"
        "auto manifestSchemaLock() -> std::span<const SchemaNodePin> { return kManifestSchemaLock; }\n\n"
        "} // namespace bloom::quality::schema_detail\n",
        encoding="utf-8",
    )


if __name__ == "__main__":
    main()
