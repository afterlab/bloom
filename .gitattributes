# Digest-bound dependency artifacts must never be line-ending normalized or otherwise rewritten:
# the intake contract binds their exact bytes to SHA-256 records.
dependencies/unicode/** -text
dependencies/licenses/** -text
# The CPython patch changes Visual Studio project files, which have Windows line endings; its
# context lines must keep them or it no longer applies.
dependencies/patches/python/** -text
assets/ocio/** -text

# Vendored interface assets are digest-bound in their provenance records (src/ui/kit/third_party/
# */provenance.md): their exact bytes are what those SHA-256 values cover, so they must never be
# line-ending normalized or otherwise rewritten.
src/ui/kit/third_party/** -text

# A project and document as an older build wrote them: the migration test compares their exact bytes.
tests/fixtures/paths/** -text
