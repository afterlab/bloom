from collections.abc import Mapping, Sequence
from typing import Any

Key = tuple[Any, Any] | tuple[Any, Any, str]

class SceneResult:
    layers: Mapping[str, int]
    nodes: Mapping[str, int]
    steps: int

class Layer:
    name: str
    @property
    def id(self) -> int: ...
    def set(self, role: str, value: Any) -> Layer: ...
    def animate(self, role: str, keys: Sequence[Key], *, ease: str | None = ...,
                seconds: bool = ...) -> Layer: ...
    def parent_to(self, parent: Layer | None) -> Layer: ...
    def matte_with(self, source: Layer, *, channel: str = ..., inverted: bool = ...) -> Layer: ...

class Node:
    name: str
    @property
    def id(self) -> int: ...
    def set(self, role: str, value: Any) -> Node: ...
    def animate(self, role: str, keys: Sequence[Key], *, ease: str | None = ...,
                seconds: bool = ...) -> Node: ...
    def feeds(self, target: Node, port: str = ..., *, source_port: str = ...) -> Node: ...

class Scene:
    label: str
    def __init__(self, label: str = ..., *, composition: int | None = ...) -> None: ...
    def solid(self, name: str, color: Sequence[float], *, position: Sequence[float] | None = ...,
              opacity: float | None = ...) -> Layer: ...
    def text(self, name: str, text: str, *, position: Sequence[float] | None = ...,
             size: float | None = ..., color: Sequence[float] | None = ...,
             opacity: float | None = ...) -> Layer: ...
    def shape(self, name: str, kind: str, *, position: Sequence[float] | None = ...,
              size: Sequence[float] | None = ...) -> Layer: ...
    def node(self, name: str, node_type: str, *, position: Sequence[float] | None = ...) -> Node: ...
    def layer(self, name: str) -> Layer: ...
    def commit(self) -> SceneResult: ...
    def undo(self) -> None: ...
