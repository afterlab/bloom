  "bindings": [
    {"set": 0, "binding": 0, "kind": "storage-buffer", "access": "readonly", "element": "uint",
     "role": "stored-display-frame-cells (4 bytes a pixel, row-major; display_pixel_packing.hpp)"},
    {"set": 0, "binding": 4, "kind": "storage-image", "access": "writeonly", "format": "rgba32f",
     "role": "display-signal-picture (red, green, blue = the Display code over black / 1023; alpha = the stored alpha)"}
