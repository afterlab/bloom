    "localSizeZ": 1
  },
  "bindings": [
    {"set": 0, "binding": 0, "kind": "storage-image", "access": "readonly", "format": "rgba32f", "role": "second-image-or-matte"},
    {"set": 0, "binding": 1, "kind": "storage-image", "access": "readonly", "format": "rgba32f", "role": "base-image"},
    {"set": 0, "binding": 2, "kind": "storage-image", "access": "writeonly", "format": "rgba32f", "role": "premultiplied-output"},
    {"set": 0, "binding": 3, "kind": "storage-buffer", "access": "readwrite", "element": "uint", "role": "error-flag"},
    {"set": 0, "binding": 4, "kind": "storage-image", "access": "readonly", "format": "rgba32f", "role": "image-mix-mask"}
  ],
  "pushConstant": {
    "byteCount": 56,
    "fields": ["destWidth", "destHeight", "sourceWidth", "sourceHeight", "sourceOffsetX", "sourceOffsetY", "mode", "factor", "channel", "maskWidth", "maskHeight", "maskOffsetX", "maskOffsetY", "maskMode"]
  },
  "contracts": {
    "alignment": "Second input sampled at the base image's global integer pixel coordinate; outside its data window is transparent black",
    "alpha": "finite premultiplied RGBA32F; matte R, G and B channel extraction uses straight scene-linear colour, Luma uses premultiplied scene-linear Rec. 709 luma, and zero alpha gives zero coverage",
    "nonFinitePolicy": "input non-finite/subnormal or non-finite result sets a status flag; never publish a flagged image",
    "modes": "8 Image Mix; 9 Set Alpha; 10 Multiply Alpha; 11 Set Channel (the base with one slot set to the second image's stored channel, alpha limited to [0, 1], optional RGB premultiply)",
    "channel": "bits 0-2 select A, R, G, B or premultiplied scene-linear luma; bit 3 inverts the unit coverage; Set Channel reads the stored channel unclamped and carries its slot (R, G, B, A) in bits 4-5 and premultiply in bit 6",
    "absentMatte": "an empty source extent makes every tap transparent black (zero coverage)",
    "mask": "Image Mix only: maskMode 1 scales the factor by the mask alpha at the base pixel's global coordinate (zero outside its data window); 2 is an absent mask (zero); 0 ignores binding 4"
  }
}
