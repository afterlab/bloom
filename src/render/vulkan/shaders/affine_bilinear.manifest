  "hostDerivation": {
    "samples": "prepareAffineMap(LayerTransform, outputWindow) or prepareAffineMatrixMap(GpuAffineMatrix, outputWindow): probe the exact CPU oracle inverse (LayerTransform::inverseMap() or the composed matrix closed-form inverse) at the output origin and one local pixel step along each axis, then upload the six binary64 coefficients as error-free double-float (hi, lo) pairs. O(1) host work; the per-pixel source-local coordinate, the floor/factor reduction, the transparent range test, and the bilinear gather all run on the GPU. The GPU map is coordinate metadata only and never CPU-generated RGBA.",
    "source": "GpuImageUpload/Rgba32fImage decode is done on the CPU task thread; no media decode on the GPU owner thread",
    "opacity": "LayerTransform::opacity() for the LayerTransform form; the explicitly supplied float32 for the composed-matrix form",
    "checked": "dispatch ceil(outputWidth*outputHeight/256); host preflights the image + O(1) metadata budget and device limits"
  },
  "contracts": {
    "numeric": "composed-matrix form: bit-exact on all four components against render::affineMatrixResampleRow, the CPU reference that repeats this kernel's double-float coordinate reconstruction, tap selection, lerp and opacity in IEEE binary32 (#545). LayerTransform form: per-finite-component abs-or-rel 2e-6 against render::layerTransformBilinearRow.",
    "arithmetic": "CPU uses std::fma(factor,end,(1-factor)*start); shader uses fma() for the same lerp; SPIR-V relaxed contraction is covered by the 2e-6 gate",
    "sampleConvention": "the kernel reconstructs the per-pixel source-local coordinate from six O(1) binary64 inverse-affine coefficients in portable error-free double-float (Dekker/Knuth two-sum/two-product with fma, renormalized). Every rounding-sensitive operation carries `precise`, which glslang only honors for statement-level locals: the two_sum/two_prod steps are inlined in df_add/df_mul because `precise` does not propagate through a struct return or out-parameter. SPIR-V therefore marks every error-free term NoContraction. The reduction (int)floor and single Float32 fraction reproduce the CPU rule: floor(hi+lo) is floor(hi) except when hi is integral and lo<0, and factor is the single rounding of (hi - floor) + lo. No shaderFloat64 and no 64-bit integer type.",
    "sampling": "0 bilinear; 1 nearest (#480): the single tap at base + (factor >= 0.5) on each axis, times the opacity, bit-exact against the parented nearest row (ParentedLayerTransform) when both reduce to the same tap",
    "opacity": "opacity==0 writes transparent; opacity==1 skips the multiply; otherwise sampled *= opacity",
    "transparentBorder": "base +/- 1 taps outside the source data window are exact transparent black, so premultiplied interpolation produces the correct edge falloff with no unpremultiply round trip",
    "zeroScale": "a collapsed layer (scale 0 on either axis) has no inverse and is an empty layer before resampling; LayerTransform::create refuses it and this operation must not be submitted for one",
    "nonFinitePolicy": "any non-finite tap sets bit0, any nonzero subnormal tap sets bit2, a non-finite result sets bit1; on any error the output pixel is transparent and the consumer must not publish while flags[0] != 0",
    "cpuFallback": "non-finite/subnormal domains and any precision the shader cannot match stay on the CPU reference path; no silent substitution",
    "metadataBudget": "the compact inverse-affine map is six binary64 coefficients (48 bytes) regardless of output extent, charged against maxMetadataBytes and the per-call byteBudget; it is coordinate metadata only, never CPU-generated RGBA"
  }
}
