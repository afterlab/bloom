#version 460
// Flat RGBA image combine. Inputs stay resident. Source is the second image/matte;
// backdrop is the first image. Both use composition-space integer pixel centres.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba32f) uniform readonly image2D bloom_source;
layout(set = 0, binding = 1, rgba32f) uniform readonly image2D bloom_backdrop;
layout(set = 0, binding = 2, rgba32f) uniform writeonly image2D bloom_output;
layout(set = 0, binding = 3) buffer BloomImageCombineError { uint flags[]; } bloom_error;
// ADR 0028: Image Mix's optional Mask, read from its alpha at the base pixel's global coordinate.
layout(set = 0, binding = 4, rgba32f) uniform readonly image2D bloom_mask;

layout(push_constant) uniform BloomImageCombinePush {
    uint destWidth;
    uint destHeight;
    uint sourceWidth;
    uint sourceHeight;
    int sourceOffsetX;
    int sourceOffsetY;
    uint mode;              // 8=Image Mix, 9=Set Alpha, 10=Multiply Alpha, 11=Set Channel, 12=Unsharp
    float factor;           // finite unit factor, validated by host; Unsharp: the finite amount >= 0
    uint channel;           // bits 0-2: 0=A, 1=R, 2=G, 3=B, 4=premultiplied luma; bit 3: invert;
                            // Set Channel: bits 4-5 the written slot (R, G, B, A), bit 6 premultiply
    uint maskWidth;
    uint maskHeight;
    int maskOffsetX;
    int maskOffsetY;
    uint maskMode;          // 0=no mask, 1=mask image, 2=absent mask (zero coverage)
    float threshold;        // Unsharp only: the finite threshold >= 0, validated by host
} bloom_push;

bool subnormal(float value) {
    uint bits = floatBitsToUint(value) & 0x7fffffffu;
    return bits != 0u && bits < 0x00800000u;
}
uint pixelErrors(vec4 value) {
    uint result = 0u;
    if (any(isnan(value)) || any(isinf(value))) result |= 1u;
    if (subnormal(value.x) || subnormal(value.y) || subnormal(value.z) ||
        subnormal(value.w)) result |= 4u;
    return result;
}
// Two-component Float32 arithmetic retains the residuals that matter when signed HDR
// inputs cancel. `precise` forbids reassociation; explicit fma recovers product error.
// No optional Float64 device capability is needed.
vec2 twoSum(float a, float b) {
    precise float sum = a + b;
    precise float carried = sum - a;
    precise float error = (a - (sum - carried)) + (b - carried);
    return vec2(sum, error);
}
vec2 addWide(vec2 a, vec2 b) {
    vec2 sum = twoSum(a.x, b.x);
    precise float error = sum.y + (a.y + b.y);
    return twoSum(sum.x, error);
}
vec2 productWide(float a, float b) {
    precise float product = a * b;
    return vec2(product, fma(a, b, -product));
}
vec2 scaleWide(vec2 a, float b) {
    vec2 product = productWide(a.x, b);
    precise float error = product.y + a.y * b;
    return twoSum(product.x, error);
}
float mixComponent(float a, float b, float t) {
    if (t == 0.0) return a;
    if (t == 1.0) return b;
    vec2 result = addWide(scaleWide(twoSum(1.0, -t), a), productWide(b, t));
    return result.x + result.y;
}
float luma(vec3 rgb) {
    // High/low splits of the CPU reference's double Rec.709 coefficients.
    vec2 red = scaleWide(vec2(0.2125999927520752, 7.247924815878548e-9), rgb.r);
    vec2 green = scaleWide(vec2(0.7152000069618225, -6.9618225628786945e-9), rgb.g);
    vec2 blue = scaleWide(vec2(0.0722000002861023, -2.86102294633217e-10), rgb.b);
    vec2 result = addWide(addWide(red, green), blue);
    float numerator = result.x + result.y;
    return numerator;
}
float channelCoverage(vec4 matte) {
    uint channel = bloom_push.channel & 7u;
    if (channel == 0u) return matte.a;
    if (matte.a <= 0.0) return 0.0;
    float value = 0.0;
    if (channel == 1u) value = matte.r / matte.a;
    else if (channel == 2u) value = matte.g / matte.a;
    else if (channel == 3u) value = matte.b / matte.a;
    else value = luma(matte.rgb);  // premultiplied: the matte's alpha feathers its luma
    return clamp(value, 0.0, 1.0);
}
// An inverted matte is the exact Float32 complement, matching render::matteCoverage.
float coverage(vec4 matte) {
    precise float value = channelCoverage(matte);
    return (bloom_push.channel & 8u) != 0u ? 1.0 - value : value;
}

// #479 Set Channel reads the second image's STORED channel: no division by alpha, no clamp.
float storedChannel(vec4 second) {
    uint channel = bloom_push.channel & 7u;
    if (channel == 0u) return second.a;
    if (channel == 1u) return second.r;
    if (channel == 2u) return second.g;
    if (channel == 3u) return second.b;
    return luma(second.rgb);
}

// #486 Unsharp divides correctly rounded on every device, as ocioGpuPreciseDivisionGlsl does: some
// devices do not round `a / b` to nearest-even, and the detail below is the difference of nearly equal
// values, so an error here would be scaled by the amount.
float nextUp(float x) {
    uint u = floatBitsToUint(x);
    if (x == 0.0) return uintBitsToFloat(1u);
    return x > 0.0 ? uintBitsToFloat(u + 1u) : uintBitsToFloat(u - 1u);
}
float nextDown(float x) {
    uint u = floatBitsToUint(x);
    if (x == 0.0) return uintBitsToFloat(0x80000001u);
    return x > 0.0 ? uintBitsToFloat(u - 1u) : uintBitsToFloat(u + 1u);
}
float roundedDivide(float a, float b) {
    precise float q = a / b;
    precise float r = fma(-b, q, a);
    q = q + r / b;
    r = fma(-b, q, a);
    q = q + r / b;
    r = fma(-b, q, a);
    if (r != 0.0) {
        float up = nextUp(q);
        float down = nextDown(q);
        bool away = (r > 0.0) == (b > 0.0);
        precise float gap = away ? abs(up - q) : abs(q - down);
        precise float midpoint = abs(b) * 0.5 * gap;
        if (abs(r) > midpoint) {
            q = away ? up : down;
        } else if (abs(r) == midpoint && (floatBitsToUint(q) & 1u) != 0u) {
            q = away ? up : down;
        }
    }
    return q;
}
// The same binary32 operations as render::unsharpImageChannel.
float unsharpChannel(float value, float blurred, float scale, float threshold) {
    precise float detail = fma(-scale, blurred, value);
    precise float cored = 0.0;
    if (detail > threshold) cored = detail - threshold;
    else if (detail < -threshold) cored = detail + threshold;
    precise float sharpened = fma(bloom_push.factor, cored, value);
    float result = max(sharpened, min(value, 0.0));
    return subnormal(result) ? 0.0 : result;
}

// Shift alpha by 24 bits so half the least subnormal is a normal Float32.
// A nonzero subnormal CPU alpha cannot be reproduced on flush-to-zero devices;
// reject that numerical case through the existing status/CPU fallback boundary.
bool needsSubnormalAlpha(float scaledAlpha) {
    const float minNormal = uintBitsToFloat(0x00800000u);
    return scaledAlpha > minNormal && scaledAlpha < minNormal * 16777216.0;
}
void main() {
    uvec2 index = gl_GlobalInvocationID.xy;
    if (index.x >= bloom_push.destWidth || index.y >= bloom_push.destHeight) return;
    ivec2 destination = ivec2(index);
    ivec2 sourceLocal = destination + ivec2(bloom_push.sourceOffsetX,
                                               bloom_push.sourceOffsetY);
    bool inside = sourceLocal.x >= 0 && sourceLocal.y >= 0 &&
                  sourceLocal.x < int(bloom_push.sourceWidth) &&
                  sourceLocal.y < int(bloom_push.sourceHeight);
    vec4 a = imageLoad(bloom_backdrop, destination);
    vec4 b = inside ? imageLoad(bloom_source, sourceLocal) : vec4(0.0);
    uint errors = pixelErrors(a);
    // #486 Unsharp reads a blur's faint tails, where a subnormal is ordinary, and only as a difference
    // far below any value it changes: there, only a non-finite second image is an error.
    if (inside) errors |= bloom_push.mode == 12u ? pixelErrors(b) & 1u : pixelErrors(b);
    if (errors != 0u) {
        atomicOr(bloom_error.flags[0], errors);
        imageStore(bloom_output, destination, a);
        return;
    }
    vec4 result = vec4(0.0);
    if (bloom_push.mode == 8u) {
        float t = bloom_push.factor;
        if (bloom_push.maskMode != 0u) {
            ivec2 maskLocal = destination + ivec2(bloom_push.maskOffsetX, bloom_push.maskOffsetY);
            bool maskInside = bloom_push.maskMode == 1u && maskLocal.x >= 0 && maskLocal.y >= 0 &&
                              maskLocal.x < int(bloom_push.maskWidth) &&
                              maskLocal.y < int(bloom_push.maskHeight);
            precise float masked = bloom_push.factor *
                                   (maskInside ? imageLoad(bloom_mask, maskLocal).a : 0.0);
            t = masked;
        }
        if (needsSubnormalAlpha(mixComponent(a.a * 16777216.0, b.a * 16777216.0, t))) {
            atomicOr(bloom_error.flags[0], 4u);
            imageStore(bloom_output, destination, a);
            return;
        }
        result = vec4(mixComponent(a.r, b.r, t), mixComponent(a.g, b.g, t),
                      mixComponent(a.b, b.b, t), mixComponent(a.a, b.a, t));
    } else if (bloom_push.mode == 9u) {
        float alpha = coverage(b);
        result = a.a > 0.0 ? vec4(a.rgb * (alpha / a.a), alpha)
                           : vec4(0.0, 0.0, 0.0, alpha);
    } else if (bloom_push.mode == 10u) {
        // #532: the CPU reference's order (render::multiplyAlphaAmount): amount is one Float32
        // product of the unit coverage and unit factor, then each premultiplied component times
        // amount is rounded once, so alpha is bit-exact for every factor.
        float matteCoverage = coverage(b);
        precise float amount = matteCoverage * bloom_push.factor;
        // A nonzero subnormal amount or result alpha cannot be reproduced on flush-to-zero
        // devices; both are tested 2^24 up, where they are normal.
        precise float scaledAmount = matteCoverage * 16777216.0;
        scaledAmount = scaledAmount * bloom_push.factor;
        precise float scaledAlpha = a.a * 16777216.0;
        scaledAlpha = scaledAlpha * amount;
        if (needsSubnormalAlpha(scaledAmount) || needsSubnormalAlpha(scaledAlpha)) {
            atomicOr(bloom_error.flags[0], 4u);
            imageStore(bloom_output, destination, a);
            return;
        }
        precise vec4 scaled = a * amount;
        result = scaled;
    } else if (bloom_push.mode == 11u) {
        // The base with one slot set; alpha limited to [0, 1]; Straight premultiplies RGB.
        uint slot = (bloom_push.channel >> 4) & 3u;
        float value = storedChannel(b);
        result = a;
        if (slot == 0u) result.r = value;
        else if (slot == 1u) result.g = value;
        else if (slot == 2u) result.b = value;
        else result.a = value;
        result.a = clamp(result.a, 0.0, 1.0);
        if ((bloom_push.channel & 64u) != 0u) {
            precise vec3 premultiplied = result.rgb * result.a;
            result.rgb = premultiplied;
        }
        // A nonzero subnormal result cannot be reproduced on flush-to-zero devices; refuse it
        // through the status/CPU fallback boundary rather than publish a flushed value.
        if ((pixelErrors(result) & 4u) != 0u) {
            atomicOr(bloom_error.flags[0], 4u);
            imageStore(bloom_output, destination, a);
            return;
        }
    } else if (bloom_push.mode == 12u) {
        // #486 Sharpen: the base plus the amount times its colour's difference from the second
        // image's (its blur) colour at this pixel, in proportion to its alpha, which is kept.
        result = a;
        if (a.a > 0.0 && b.a > 0.0) {
            float scale = roundedDivide(a.a, b.a);
            precise float threshold = a.a * bloom_push.threshold;
            result.r = unsharpChannel(a.r, b.r, scale, threshold);
            result.g = unsharpChannel(a.g, b.g, scale, threshold);
            result.b = unsharpChannel(a.b, b.b, scale, threshold);
        }
    } else {
        atomicOr(bloom_error.flags[0], 2u);
        imageStore(bloom_output, destination, a);
        return;
    }
    if (any(isnan(result)) || any(isinf(result))) {
        atomicOr(bloom_error.flags[0], 2u);
        imageStore(bloom_output, destination, a);
        return;
    }
    // Rgba32f::fromPremultiplied canonicalizes zero alpha after float rounding.
    // RGB can remain nonzero when alpha underflows, so enforce the same invariant here.
    if (result.a == 0.0) result = vec4(0.0);
    imageStore(bloom_output, destination, result);
}
