      {"name": "crDenominator", "type": "float32"},
      {"name": "histogramOffset", "type": "uint32"},
      {"name": "waveformOffset", "type": "uint32"},
      {"name": "vectorscopeOffset", "type": "uint32"},
      {"name": "chromaticityOffset", "type": "uint32"},
      {"name": "groupWidth", "type": "uint32"},
      {"name": "detail", "type": "uint32", "values": "0 = full detail, 1 or 2: the Vectorscope and Chromaticity tables are 512 >> detail cells a side and the Waveform has 512 >> detail levels"}
    ]
  },
  "contracts": {
    "numeric": "exact against the scope CPU reference (src/runtime/scope_measure.cpp) for the same float input: every cell is a whole number of pixels added with atomicAdd, and the binary32 arithmetic that places a pixel is the reference's, in the same order, precise",
    "readback": "only the count tables are read back (prep.scopes.result_readback); the picture never is",
    "cpuFallback": "an invalid request, a device-limit or budget refusal, or a wrong thread fails closed with an explicit diagnostic; the caller then measures with the CPU reference and labels the result CPU"
