     "role": "signal-picture (red, green, blue = the signal over black; alpha = the pixel's alpha)"},
    {"set": 0, "binding": 1, "kind": "storage-image", "access": "readonly", "format": "rgba32f",
     "role": "signal-picture-in-cie-xyz-d65; read only with the Chromaticity table"},
    {"set": 0, "binding": 2, "kind": "storage-buffer", "access": "readwrite", "element": "uint",
     "role": "scope-count-tables", "layout": "8 counters, then the Histogram, Waveform, Vectorscope and Chromaticity tables that were asked for (scope_table_layout.hpp); the Vectorscope, Chromaticity and Waveform sizes follow the detail"}
  ],
  "pushConstant": {
    "byteCount": 80,
    "fields": [
      {"name": "pass", "type": "uint32", "values": "0 = one invocation per pixel, 1 = one invocation per Waveform column"},
      {"name": "scopes", "type": "uint32", "values": "1 Histogram, 2 Waveform, 4 Vectorscope, 8 Chromaticity"},
      {"name": "flags", "type": "uint32", "values": "1 = ignore transparent pixels"},
      {"name": "columns", "type": "uint32"},
      {"name": "areaX", "type": "int32"},
