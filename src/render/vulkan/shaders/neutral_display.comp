  {
    vec4 breakPnt = vec4(0.00303993467, 0.00303993467, 0.00303993467, 1.);
    vec4 slope = vec4(12.9232101, 12.9232101, 12.9232101, 1.);
    vec4 scale = vec4(1.05499995, 1.05499995, 1.05499995, 1.00000095);
    vec4 offset = vec4(0.0549999997, 0.0549999997, 0.0549999997, 9.99999997e-07);
    vec4 gamma = vec4(0.416666657, 0.416666657, 0.416666657, 0.999998987);
    vec4 isAboveBreak = vec4(greaterThan( outColor, breakPnt));
    vec4 linSeg = outColor * slope;
    vec4 powSeg = pow( max( vec4(0., 0., 0., 0.), outColor ), gamma ) * scale - offset;
    vec4 res = isAboveBreak * powSeg + ( vec4(1., 1., 1., 1.) - isAboveBreak ) * linSeg;
    outColor.rgb = vec3(res.x, res.y, res.z);
    outColor.a = res.w;
  }

  return outColor;
}


// Packs one pixel and returns what it found: bit 0 the pixel does not allow the
// 10:10:10:2 layout, bits 1..4 under (red, green, blue, luma), bits 5..8 over, bit 9
// not finite, bits 16..19 the error bits.
uint bloom_neutral_v1_pixel(uint index)
{
    vec4 premultiplied = bloom_input.pixels[index];
    uint errors = 0u;
    if (any(isnan(premultiplied)) || any(isinf(premultiplied))) {
        errors |= 1u;
    }
    // Any nonzero subnormal input lane rejects the whole frame until denormal
    // preservation is qualified; the intended route for such a frame is a CPU fallback.
    uvec4 inputBits = floatBitsToUint(premultiplied);
    uvec4 exponentBits = inputBits & uvec4(0x7F800000u);
    uvec4 mantissaBits = inputBits & uvec4(0x007FFFFFu);
    bvec4 inputIsSubnormal = bvec4(exponentBits.x == 0u && mantissaBits.x != 0u,
                                   exponentBits.y == 0u && mantissaBits.y != 0u,
                                   exponentBits.z == 0u && mantissaBits.z != 0u,
                                   exponentBits.w == 0u && mantissaBits.w != 0u);
    if (any(inputIsSubnormal)) {
        errors |= 8u;
    }
    if (errors != 0u) {
        bloom_output.words[index] = 0u;
        return errors << 16u;
    }

    float alpha = premultiplied.a;
    vec3 straight = vec3(0.0);
    if (alpha != 0.0) {
        straight = premultiplied.rgb / alpha;
        if (any(isnan(straight)) || any(isinf(straight))) {
            errors |= 2u;
        }
    }
    if (errors != 0u) {
        bloom_output.words[index] = 0u;
        return errors << 16u;
    }

    // OCIO affects RGB only. The alpha lane fed to the transform is 1.0 and the transform's
    // alpha result is discarded because Bloom carries the original alpha unchanged.
    vec3 displayRgb = bloom_neutral_v1_display(vec4(straight, 1.0)).rgb;
    if (any(isnan(displayRgb)) || any(isinf(displayRgb))) {
        errors |= 4u;
    }
    if (errors != 0u) {
        bloom_output.words[index] = 0u;
        return errors << 16u;
    }

    // The frame counters: the display color over black, before any clamp.
    uint events = 0u;
    precise float signalRed = displayRgb.r * alpha;
    precise float signalGreen = displayRgb.g * alpha;
    precise float signalBlue = displayRgb.b * alpha;
    if (!bloom_neutral_v1_finite(signalRed) || !bloom_neutral_v1_finite(signalGreen) ||
        !bloom_neutral_v1_finite(signalBlue) || !bloom_neutral_v1_finite(alpha)) {
        events |= 1u << 9u;
    } else {
        uint rangeRed = bloom_neutral_v1_range(signalRed);
        uint rangeGreen = bloom_neutral_v1_range(signalGreen);
        uint rangeBlue = bloom_neutral_v1_range(signalBlue);
        if (rangeRed == 1u) { events |= 1u << 1u; }
        if (rangeGreen == 1u) { events |= 1u << 2u; }
        if (rangeBlue == 1u) { events |= 1u << 3u; }
        if (rangeRed == 2u) { events |= 1u << 5u; }
        if (rangeGreen == 2u) { events |= 1u << 6u; }
        if (rangeBlue == 2u) { events |= 1u << 7u; }
        if (bloom_push.lumaCounted != 0u) {
            precise float redPart = bloom_push.lumaRed * signalRed;
            precise float greenPart = bloom_push.lumaGreen * signalGreen;
            precise float redGreen = redPart + greenPart;
            precise float bluePart = bloom_push.lumaBlue * signalBlue;
            precise float luma = redGreen + bluePart;
            uint rangeLuma = bloom_neutral_v1_range(luma);
            if (rangeLuma == 1u) { events |= 1u << 4u; }
            if (rangeLuma == 2u) { events |= 1u << 8u; }
        }
    }

    // A pixel allows the 10:10:10:2 layout when its alpha is exactly 0 or packs to the
    // 8-bit alpha 255.
    uint alphaByte = bloom_neutral_v1_quantize_byte(alpha);
    bool allowed = alpha == 0.0 || alphaByte == 255u;
    if (!allowed) { events |= 1u; }
    if (bloom_push.pixelLayout == 1u) {
        // A transparent pixel is the word 0. So is a pixel that is not allowed: the
        // frame is then refused and packed again as 8:8:8:8.
        uint word = 0u;
        if (allowed && alpha != 0.0) {
            word = bloom_neutral_v1_code10(displayRgb.r) |
                   (bloom_neutral_v1_code10(displayRgb.g) << 10u) |
                   (bloom_neutral_v1_code10(displayRgb.b) << 20u) | (3u << 30u);
        }
        bloom_output.words[index] = word;
        return events;
    }
    uint red = bloom_neutral_v1_quantize_byte(displayRgb.r);
    uint green = bloom_neutral_v1_quantize_byte(displayRgb.g);
    uint blue = bloom_neutral_v1_quantize_byte(displayRgb.b);
    bloom_output.words[index] = red | (green << 8) | (blue << 16) | (alphaByte << 24);
    return events;
}

