#version 460
// Bloom ScopeTablesV1 compute shader (#724, #730, #733). Offline-generated/embedded; do not edit at runtime.
//
// Counts the pixels of a measured area into the scope tables of docs/architecture/scopes.md,
// exactly as the CPU reference does (src/runtime/scope_measure.cpp). Every table cell is a whole
// number of pixels, added with atomicAdd on a uint storage buffer: integer adds commute, so the
// result does not depend on how the device schedules the invocations. All float arithmetic is
// binary32, in the order written, `precise` (no contraction), and constants that are not exact in
// decimal are written as bits. A device's own float division is not required to be correctly
// rounded and is not on every device, so every division goes through bloom_scope_divide, which
// corrects the device's quotient to the correctly rounded one the CPU computes (the method of the
// OCIO wrapper's bloom_ocio_cpu_div).
//
// Binding 0 is the signal picture: red, green, blue are the signal taken over black (the
// premultiplied color) and alpha the pixel's alpha. Binding 1 is the same picture converted to
// CIE XYZ (D65) and is read only when the Chromaticity table is asked for (the signal picture is
// bound there otherwise). Binding 2 is the table buffer, zeroed by the host before the dispatch:
//   words[0] pixels counted, [1] not finite, [2] no chromaticity, [3] chromaticity outside,
//   [4] vectorscope outside, [5..7] zero;
//   histogramOffset:    4 channels (red, green, blue, luma) x 1026: 1024 bins, under, over;
//   waveformOffset:     4 channels x `columns` x 1026: the 1024 codes, under, over;
//   vectorscopeOffset:  640 rows (Cr) x 640 (Cb) counts, then 640 x 640 luma sums (the pixel's
//                       luma code, clipped to 0..1023, shifted right by 4);
//   chromaticityOffset: 512 rows (y) x 512 (x).
// #733: `reduction` halves a table axis (render/scope_table_layout.hpp): a pixel's cell in the
// reduced table is its cell in the full table shifted right, so a reduced cell holds the exact sum
// of the full cells it covers. The Waveform then has ceil(fullColumns / 2^shift) columns of
// (1024 >> shift) levels plus under and over, the Vectorscope (640 >> shift) cells an axis and the
// Chromaticity table (512 >> shift). The sizes above are the full tables (every shift 0).
//
// Two passes, selected by `pass`, both flattened into 256-wide workgroups of `groupWidth`
// invocations a row; invocations past the count return immediately.
//   pass 0: one invocation per pixel of the measured area: the counters, the Histogram, the
//           Vectorscope and the Chromaticity table.
//   pass 1: one invocation per Waveform column of the (reduced) table. It owns that column of
//           the table and walks the pixels that fall in it, so no other invocation adds to its
//           cells.
// A pixel of the measured area outside the picture is transparent black.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D bloom_scope_signal;
layout(set = 0, binding = 1, rgba32f) uniform readonly image2D bloom_scope_xyz;
layout(set = 0, binding = 2, std430) buffer BloomScopeTables {
    uint words[];
} bloom_scope_tables;

layout(push_constant) uniform BloomScopePushConstants {
    uint pass;
    uint scopes;             // 1 Histogram, 2 Waveform, 4 Vectorscope, 8 Chromaticity
    uint flags;              // 1 ignore transparent pixels
    uint columns;
    int areaX;               // the measured area's corner, in picture pixels
    int areaY;
    uint areaWidth;
    uint areaHeight;
    float inverseMaximum;    // 1 / M, M a power of two
    float lumaRed;
    float lumaGreen;
    float lumaBlue;
    float cbDenominator;     // 2 (1 - Kb), rounded once on the host
    float crDenominator;     // 2 (1 - Kr)
    uint histogramOffset;
    uint waveformOffset;
    uint vectorscopeOffset;
    uint chromaticityOffset;
    uint groupWidth;
    uint fullColumns;        // the full Waveform's columns: min(512, areaWidth)
    uint reduction;          // shifts: Waveform columns | levels << 8 | Vectorscope << 16 |
                             // Chromaticity << 24
} bloom_scope_push;

const uint kScopeHistogram = 1u;
const uint kScopeVectorscope = 4u;
const uint kScopeChromaticity = 8u;
const uint kCodeUnder = 1024u;
const uint kCodeOver = 1025u;

precise float bloom_scope_next_up(float x)
{
    const uint u = floatBitsToUint(x);
    if (x == 0.0) { return uintBitsToFloat(1u); }
    return (x > 0.0) ? uintBitsToFloat(u + 1u) : uintBitsToFloat(u - 1u);
}

precise float bloom_scope_next_down(float x)
{
    const uint u = floatBitsToUint(x);
    if (x == 0.0) { return uintBitsToFloat(0x80000001u); }
    return (x > 0.0) ? uintBitsToFloat(u - 1u) : uintBitsToFloat(u + 1u);
}

// a / b, correctly rounded to nearest (ties to even). The residual of the device's quotient is
// exact (fma), so two refinements bring the quotient within one unit in the last place and the
// last step moves it to the nearer neighbor of the exact quotient q + r / b.
precise float bloom_scope_divide(float a, float b)
{
    precise float q = a / b;
    precise float r = fma(-b, q, a);
    q = q + r / b;
    r = fma(-b, q, a);
    q = q + r / b;
    r = fma(-b, q, a);
    if (r != 0.0) {
        precise float up = bloom_scope_next_up(q);
        precise float down = bloom_scope_next_down(q);
        precise bool away = (r > 0.0) == (b > 0.0);
        precise float gap = away ? abs(up - q) : abs(q - down);
        precise float midpoint = abs(b) * 0.5 * gap;
        if (abs(r) > midpoint) {
            q = away ? up : down;
        } else if (abs(r) == midpoint && (floatBitsToUint(q) & 1u) != 0u) {
            q = away ? up : down;
        }
    }
    return q;
}

bool bloom_scope_not_finite(float value)
{
    return (floatBitsToUint(value) & 0x7F800000u) == 0x7F800000u;
}

// The code of a component: floor(v / M * 1023 + 0.5), 0..1023, or under (and a value that is not a
// number) or over.
uint bloom_scope_code(float value)
{
    precise float scaled = value * bloom_scope_push.inverseMaximum;
    precise float coded = scaled * 1023.0;
    precise float rounded = coded + 0.5;
    float whole = floor(rounded);
    if (!(whole >= 0.0)) {
        return kCodeUnder;
    }
    if (!(whole <= 1023.0)) {
        return kCodeOver;
    }
    return uint(whole);
}

// 0 counted, 1 not finite, 2 not counted (a transparent pixel being ignored).
uint bloom_scope_load(ivec2 area, out vec4 signal, out ivec2 coordinate, out bool inside)
{
    coordinate = ivec2(bloom_scope_push.areaX, bloom_scope_push.areaY) + area;
    ivec2 size = imageSize(bloom_scope_signal);
    inside = coordinate.x >= 0 && coordinate.y >= 0 && coordinate.x < size.x &&
             coordinate.y < size.y;
    signal = inside ? imageLoad(bloom_scope_signal, coordinate) : vec4(0.0);
    if (bloom_scope_not_finite(signal.r) || bloom_scope_not_finite(signal.g) ||
        bloom_scope_not_finite(signal.b) || bloom_scope_not_finite(signal.a)) {
        return 1u;
    }
    if ((bloom_scope_push.flags & 1u) != 0u && signal.a == 0.0) {
        return 2u;
    }
    return 0u;
}

float bloom_scope_luma(vec4 signal)
{
    precise float red = bloom_scope_push.lumaRed * signal.r;
    precise float green = bloom_scope_push.lumaGreen * signal.g;
    precise float blue = bloom_scope_push.lumaBlue * signal.b;
    precise float redGreen = red + green;
    precise float luma = redGreen + blue;
    return luma;
}

void bloom_scope_add(uint index)
{
    atomicAdd(bloom_scope_tables.words[index], 1u);
}

// The Vectorscope cell of an axis: floor((value + 0.625) * 512), or 640 outside 0..639.
uint bloom_scope_vector_cell(float value)
{
    precise float shifted = value + 0.625;
    precise float scaled = shifted * 512.0;
    float whole = floor(scaled);
    if (!(whole >= 0.0) || !(whole <= 639.0)) {
        return 640u;
    }
    return uint(whole);
}

// The CIE cell of a table axis: floor(value * 512), or 512 when it is outside 0..511.
uint bloom_scope_cell(float value)
{
    precise float scaled = value * 512.0;
    float whole = floor(scaled);
    if (!(whole >= 0.0) || !(whole <= 511.0)) {
        return 512u;
    }
    return uint(whole);
}

void bloom_scope_pixel_pass(uint linear)
{
    ivec2 area = ivec2(int(linear % bloom_scope_push.areaWidth),
                       int(linear / bloom_scope_push.areaWidth));
    vec4 signal;
    ivec2 coordinate;
    bool inside;
    uint kind = bloom_scope_load(area, signal, coordinate, inside);
    if (kind == 1u) {
        bloom_scope_add(1u);
        return;
    }
    if (kind == 2u) {
        return;
    }
    bloom_scope_add(0u);
    float luma = bloom_scope_luma(signal);
    uint lumaCode = bloom_scope_code(luma);

    if ((bloom_scope_push.scopes & kScopeHistogram) != 0u) {
        uint base = bloom_scope_push.histogramOffset;
        bloom_scope_add(base + bloom_scope_code(signal.r));
        bloom_scope_add(base + 1026u + bloom_scope_code(signal.g));
        bloom_scope_add(base + 2052u + bloom_scope_code(signal.b));
        bloom_scope_add(base + 3078u + lumaCode);
    }

    if ((bloom_scope_push.scopes & kScopeVectorscope) != 0u) {
        precise float cbDifference = signal.b - luma;
        precise float cb = bloom_scope_divide(cbDifference, bloom_scope_push.cbDenominator);
        precise float crDifference = signal.r - luma;
        precise float cr = bloom_scope_divide(crDifference, bloom_scope_push.crDenominator);
        uint column = bloom_scope_vector_cell(cb);
        uint row = bloom_scope_vector_cell(cr);
        if (column == 640u || row == 640u) {
            bloom_scope_add(4u);
        } else {
            uint shift = (bloom_scope_push.reduction >> 16u) & 255u;
            uint cells = 640u >> shift;
            uint cell = (row >> shift) * cells + (column >> shift);
            uint clipped = lumaCode == kCodeUnder ? 0u : (lumaCode == kCodeOver ? 1023u : lumaCode);
            bloom_scope_add(bloom_scope_push.vectorscopeOffset + cell);
            atomicAdd(bloom_scope_tables.words[bloom_scope_push.vectorscopeOffset + cells * cells +
                                               cell],
                      clipped >> 4u);
        }
    }

    if ((bloom_scope_push.scopes & kScopeChromaticity) != 0u) {
        vec4 xyz = inside ? imageLoad(bloom_scope_xyz, coordinate) : vec4(0.0);
        precise float xy = xyz.r + xyz.g;
        precise float sum = xy + xyz.b;
        if (bloom_scope_not_finite(xyz.r) || bloom_scope_not_finite(xyz.g) ||
            bloom_scope_not_finite(xyz.b) || !(sum > 0.0)) {
            bloom_scope_add(2u);
        } else {
            // 0.8 and 0.9 as the nearest binary32.
            precise float x = bloom_scope_divide(xyz.r, sum);
            precise float xScaled = bloom_scope_divide(x, uintBitsToFloat(0x3F4CCCCDu));
            precise float y = bloom_scope_divide(xyz.g, sum);
            precise float yScaled = bloom_scope_divide(y, uintBitsToFloat(0x3F666666u));
            uint column = bloom_scope_cell(xScaled);
            uint row = bloom_scope_cell(yScaled);
            if (column == 512u || row == 512u) {
                bloom_scope_add(3u);
            } else {
                uint shift = (bloom_scope_push.reduction >> 24u) & 255u;
                bloom_scope_add(bloom_scope_push.chromaticityOffset +
                                (row >> shift) * (512u >> shift) + (column >> shift));
            }
        }
    }
}

// The cell of a Waveform column for a code: the code shifted right, or the column's under / over.
uint bloom_scope_level(uint code, uint levelShift)
{
    uint levels = 1024u >> levelShift;
    if (code < 1024u) {
        return code >> levelShift;
    }
    return code == kCodeUnder ? levels : levels + 1u;
}

void bloom_scope_column_pass(uint column)
{
    uint columns = bloom_scope_push.columns;
    uint fullColumns = bloom_scope_push.fullColumns;
    uint width = bloom_scope_push.areaWidth;
    uint columnShift = bloom_scope_push.reduction & 255u;
    uint levelShift = (bloom_scope_push.reduction >> 8u) & 255u;
    // The full columns this column covers, and the pixels x whose full column
    // floor(x * fullColumns / width) is one of them.
    uint firstFull = column << columnShift;
    uint endFull = min((column + 1u) << columnShift, fullColumns);
    uint first = (firstFull * width + fullColumns - 1u) / fullColumns;
    uint last = (endFull * width + fullColumns - 1u) / fullColumns;
    uint columnWords = (1024u >> levelShift) + 2u;
    uint base = bloom_scope_push.waveformOffset + column * columnWords;
    uint channel = columns * columnWords;
    for (uint y = 0u; y < bloom_scope_push.areaHeight; ++y) {
        for (uint x = first; x < last; ++x) {
            vec4 signal;
            ivec2 coordinate;
            bool inside;
            if (bloom_scope_load(ivec2(int(x), int(y)), signal, coordinate, inside) != 0u) {
                continue;
            }
            float luma = bloom_scope_luma(signal);
            bloom_scope_add(base + bloom_scope_level(bloom_scope_code(signal.r), levelShift));
            bloom_scope_add(base + channel +
                            bloom_scope_level(bloom_scope_code(signal.g), levelShift));
            bloom_scope_add(base + 2u * channel +
                            bloom_scope_level(bloom_scope_code(signal.b), levelShift));
            bloom_scope_add(base + 3u * channel +
                            bloom_scope_level(bloom_scope_code(luma), levelShift));
        }
    }
}

void main()
{
    uint linear = gl_GlobalInvocationID.y * bloom_scope_push.groupWidth + gl_GlobalInvocationID.x;
    if (bloom_scope_push.pass == 0u) {
        if (linear < bloom_scope_push.areaWidth * bloom_scope_push.areaHeight) {
            bloom_scope_pixel_pass(linear);
        }
    } else if (linear < bloom_scope_push.columns) {
        bloom_scope_column_pass(linear);
    }
}
