        },
        {
          "id": "bloom.feature.ffmpeg-nvdec",
          "state": "enabled",
          "reason": "NVIDIA NVDEC H.264/HEVC/AV1 decode through FFmpeg's CUDA hwaccel and ffnvcodec; the driver is loaded at run time and the build needs no nonfree component (Linux and Windows). Hardware frames are proven byte-identical to the software reference per source (ADR 0027)"
        },
        {
          "id": "bloom.feature.ffmpeg-nvenc",
