# Puts an update runtime (dependencies/update-runtime/sparkle.json or winsparkle.json) into the
# dependency prefix, by checksum.
#
#   cmake -DBLOOM_RECORD=<dependencies/update-runtime/sparkle.json>
#         -DBLOOM_DESTINATION=<prefix>/sparkle -DBLOOM_DOWNLOAD_DIR=<archive cache>
#         -DBLOOM_ALLOW_DOWNLOADS=<ON|OFF> [-DBLOOM_CHECK_ONLY=ON]
#         -P update-runtime-fetch.cmake
#
# The archive is taken from the cache or, when downloads are allowed, from the record's URL; its
# size and SHA-256 are compared with the record first, and an archive that differs stops the
# build before anything is unpacked. Of the archive only the record's `keeps` are put into the
# destination, each at the same path (below the record's `archiveRoot`, when it has one);
# symbolic links inside a kept directory stay links. <destination>/bloom-update-runtime.txt
# names the release and checksum. A destination whose note already says the same, and that
# holds every kept path, is left untouched.
cmake_minimum_required(VERSION 3.25)

foreach(required IN ITEMS BLOOM_RECORD BLOOM_DESTINATION BLOOM_DOWNLOAD_DIR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "update-runtime-fetch.cmake needs ${required}")
    endif()
endforeach()
file(READ "${BLOOM_RECORD}" record)
string(JSON format GET "${record}" format)
string(JSON version GET "${record}" version)
if(NOT format STREQUAL "bloom.update-runtime" OR NOT version EQUAL 1)
    message(FATAL_ERROR "${BLOOM_RECORD} is not a version 1 update runtime record")
endif()
foreach(field IN ITEMS name release url sha256 sizeBytes)
    string(JSON ${field} GET "${record}" ${field})
endforeach()
set(archive_root "")
string(JSON archive_root ERROR_VARIABLE archive_root_error GET "${record}" archiveRoot)
if(archive_root_error)
    set(archive_root "")
endif()
if(NOT url MATCHES "^https://[^ \t\r\n;]+$" OR NOT sha256 MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "${BLOOM_RECORD}: the URL or the checksum is malformed")
endif()
string(LENGTH "${sha256}" length)
if(NOT length EQUAL 64)
    message(FATAL_ERROR "${BLOOM_RECORD}: the checksum is not a SHA-256")
endif()
if(NOT archive_root STREQUAL "" AND NOT archive_root MATCHES "^[A-Za-z0-9._-]+$")
    message(FATAL_ERROR "${BLOOM_RECORD}: archiveRoot is malformed")
endif()
set(keeps "")
string(JSON keep_count LENGTH "${record}" keeps)
if(keep_count EQUAL 0)
    message(FATAL_ERROR "${BLOOM_RECORD}: nothing is listed under keeps")
endif()
math(EXPR keep_last "${keep_count} - 1")
foreach(index RANGE 0 ${keep_last})
    string(JSON keep GET "${record}" keeps ${index})
    # A kept path stays inside the destination: relative, no empty or dot segments.
    if(NOT keep MATCHES "^[A-Za-z0-9_+-][A-Za-z0-9._+-]*(/[A-Za-z0-9_+-][A-Za-z0-9._+-]*)*$")
        message(FATAL_ERROR "${BLOOM_RECORD}: the kept path '${keep}' is malformed")
    endif()
    list(APPEND keeps "${keep}")
endforeach()

string(REGEX REPLACE "^.*/" "" file "${url}")
set(text "${release} ${sha256} ${sizeBytes} ${file}\n")
set(note "${BLOOM_DESTINATION}/bloom-update-runtime.txt")
if(NOT BLOOM_CHECK_ONLY AND EXISTS "${note}")
    file(READ "${note}" present)
    set(complete TRUE)
    foreach(keep IN LISTS keeps)
        if(NOT EXISTS "${BLOOM_DESTINATION}/${keep}")
            set(complete FALSE)
        endif()
    endforeach()
    if(complete AND present STREQUAL text)
        message(STATUS "Bloom ${name}: ${BLOOM_DESTINATION} already holds release ${release}")
        return()
    endif()
endif()

function(bloom_runtime_problem output file)
    set(${output} "" PARENT_SCOPE)
    file(SIZE "${file}" actual_size)
    if(NOT actual_size EQUAL sizeBytes)
        set(${output} "is ${actual_size} bytes; the record says ${sizeBytes}" PARENT_SCOPE)
        return()
    endif()
    file(SHA256 "${file}" actual_digest)
    if(NOT actual_digest STREQUAL sha256)
        set(${output} "does not match its SHA-256 in the record (${actual_digest})"
            PARENT_SCOPE)
    endif()
endfunction()

file(MAKE_DIRECTORY "${BLOOM_DOWNLOAD_DIR}")
set(cached "${BLOOM_DOWNLOAD_DIR}/${file}")
set(problem "is not in the archive cache")
if(EXISTS "${cached}")
    bloom_runtime_problem(problem "${cached}")
endif()
if(problem AND BLOOM_ALLOW_DOWNLOADS)
    message(STATUS "Bloom ${name}: downloading release ${release}")
    file(DOWNLOAD "${url}" "${cached}.part" STATUS status TLS_VERIFY ON INACTIVITY_TIMEOUT 120)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
        file(REMOVE "${cached}.part")
        message(FATAL_ERROR "${url} could not be downloaded: ${status}")
    endif()
    bloom_runtime_problem(problem "${cached}.part")
    if(problem)
        file(REMOVE "${cached}.part")
        message(FATAL_ERROR "${url} ${problem}. Nothing was installed.")
    endif()
    file(RENAME "${cached}.part" "${cached}")
endif()
if(problem)
    message(FATAL_ERROR "${cached} ${problem}. (Downloads: BLOOM_DEPENDENCY_ALLOW_DOWNLOADS.)")
endif()
if(BLOOM_CHECK_ONLY)
    message(STATUS "Bloom ${name}: the archive cache holds release ${release}")
    return()
endif()

# Unpack only the kept paths into a sibling directory, then move them into place, so a stop in
# the middle leaves no half-filled destination.
set(staging "${BLOOM_DESTINATION}.unpacking")
file(REMOVE_RECURSE "${staging}")
file(MAKE_DIRECTORY "${staging}")
set(members "")
foreach(keep IN LISTS keeps)
    if(archive_root STREQUAL "")
        list(APPEND members "${keep}")
    else()
        list(APPEND members "${archive_root}/${keep}")
    endif()
endforeach()
execute_process(
    COMMAND "${CMAKE_COMMAND}" -E tar xf "${cached}" -- ${members}
    WORKING_DIRECTORY "${staging}"
    RESULT_VARIABLE unpack_result
    OUTPUT_VARIABLE unpack_output
    ERROR_VARIABLE unpack_output)
if(NOT unpack_result EQUAL 0)
    file(REMOVE_RECURSE "${staging}")
    message(FATAL_ERROR "${cached} could not be unpacked:\n${unpack_output}")
endif()
set(root "${staging}")
if(NOT archive_root STREQUAL "")
    set(root "${staging}/${archive_root}")
endif()
foreach(keep IN LISTS keeps)
    if(NOT EXISTS "${root}/${keep}")
        file(REMOVE_RECURSE "${staging}")
        message(FATAL_ERROR "${cached} does not hold ${keep}. Nothing was installed.")
    endif()
endforeach()
file(REMOVE_RECURSE "${BLOOM_DESTINATION}")
file(MAKE_DIRECTORY "${BLOOM_DESTINATION}")
foreach(keep IN LISTS keeps)
    get_filename_component(keep_parent "${keep}" DIRECTORY)
    file(MAKE_DIRECTORY "${BLOOM_DESTINATION}/${keep_parent}")
    file(RENAME "${root}/${keep}" "${BLOOM_DESTINATION}/${keep}")
endforeach()
file(REMOVE_RECURSE "${staging}")
file(WRITE "${note}" "${text}")
message(STATUS "Bloom ${name}: release ${release} in ${BLOOM_DESTINATION}")
