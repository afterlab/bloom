          "reason": "-ffp-contract=off: a multiplication and an addition are never fused, so arm64 and x86-64 compute the same"
        },
        {
          "id": "bloom.feature.python.pip",
          "state": "disabled",
          "reason": "pip and ensurepip are not installed: the carried interpreter runs Bloom scripts and installs nothing"
        },
        {
          "id": "bloom.feature.python.system-expat",
          "state": "enabled",
          "reason": "pyexpat links the locked expat component instead of the copy CPython carries"
        },
        {
          "id": "bloom.feature.python.terminal-and-tk-modules",
          "state": "disabled",
          "reason": "_tkinter, _gdbm, _dbm, _curses, _curses_panel and readline are not built on any platform, so the module set is the same everywhere; tkinter, idlelib, turtle, turtledemo, curses and ensurepip are removed from the standard library"
        },
        {
          "id": "bloom.feature.python.test-modules",
          "state": "disabled",
          "reason": "The standard library's test packages and test extension modules are not built"
