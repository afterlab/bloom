    "ffmpeg": {
      "linkage": "shared",
      "cmakeOptions": [],
      "featureDecisions": [
        {
          "id": "bloom.feature.ffmpeg-av1-hwaccel",
          "state": "enabled",
          "reason": "FFmpeg's native AV1 decoder, used only with a VA-API or NVDEC hwaccel; software AV1 decode stays dav1d"
        },
        {
          "id": "bloom.feature.ffmpeg-bwdif",
          "state": "enabled",
          "reason": "libavfilter bwdif with buffer/buffersink: field-aware deinterlacing of interlaced video in the worker"
        },
        {
          "id": "bloom.feature.ffmpeg-dav1d",
          "state": "enabled",
          "reason": "AV1 decode through the libdav1d wrapper; dav1d 1.5.4 is a static archive linked into libavcodec"
        },
        {
          "id": "bloom.feature.ffmpeg-dpx",
          "state": "enabled",
          "reason": "DPX encoder and decoder: one-frame 10-bit and 16-bit RGB DPX sequence export and its reopen check in the worker"
        },
        {
          "id": "bloom.feature.ffmpeg-kvazaar",
          "state": "enabled",
          "reason": "HEVC software encode through the libkvazaar (8-bit, HEVC Main) and libkvazaar10 (10-bit, HEVC Main 10) wrappers; Kvazaar 2.3.2 is built as two static archives linked into libavcodec"
        },
        {
          "id": "bloom.feature.ffmpeg-libvpx",
          "state": "enabled",
          "reason": "VP9 software encode (8-bit Profile 0 and 10-bit Profile 2) through the libvpx wrapper; libvpx 1.17.0 is a static archive linked into libavcodec"
        },
        {
          "id": "bloom.feature.ffmpeg-nvdec",
          "state": "enabled",
          "reason": "NVIDIA NVDEC H.264/HEVC/AV1 decode through FFmpeg's CUDA hwaccel and ffnvcodec; the driver is loaded at run time and the build needs no nonfree component (Linux and Windows). Hardware frames are proven byte-identical to the software reference per source (ADR 0027)"
        },
        {
          "id": "bloom.feature.ffmpeg-nvenc",
          "state": "enabled",
          "reason": "NVIDIA NVENC H.264/HEVC encode through ffnvcodec; the driver is loaded at run time and the build needs no nonfree component (Linux and Windows)"
        },
        {
          "id": "bloom.feature.ffmpeg-openh264",
          "state": "enabled",
          "reason": "H.264 software encode through the libopenh264 wrapper; OpenH264 2.6.0 is built from source as a static archive linked into libavcodec"
        },
        {
          "id": "bloom.feature.ffmpeg-opus",
          "state": "enabled",
          "reason": "Opus audio encode through the libopus wrapper (libopus 1.5.2 is a static archive linked into libavcodec) and FFmpeg's native Opus decoder and parser for the reopen check"
        },
        {
          "id": "bloom.feature.ffmpeg-svt-av1",
          "state": "enabled",
          "reason": "AV1 software encode (8-bit and 10-bit) through the libsvtav1 wrapper; SVT-AV1 4.2.0 is a static archive linked into libavcodec"
        },
        {
          "id": "bloom.feature.ffmpeg-vaapi",
          "state": "enabled",
          "reason": "libva is present in the qualified Linux profile; the recipe has an explicit OFF fallback"
        },
        {
          "id": "bloom.feature.ffmpeg-vp9-decode",
          "state": "enabled",
          "reason": "FFmpeg's native VP9 decoder and parser for WebM and Matroska sources"
        },
        {
          "id": "bloom.feature.ffmpeg-webm-mux",
          "state": "enabled",
          "reason": "FFmpeg's WebM muxer (the Matroska muxer's WebM profile) for VP9 and AV1 with Opus deliveries"
        },
        {
          "id": "bloom.feature.ffmpeg-x86-simd",
          "state": "enabled",
          "reason": "x86 SIMD is assembled with the superbuild-private NASM 2.16.03 build tool, passed through --x86asmexe on x86 targets only"
        }
      ],
      "capabilities": [
        "bloom.capability.ffmpeg",
