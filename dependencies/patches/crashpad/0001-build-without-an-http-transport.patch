diff --git a/util/net/http_transport_none.cc b/util/net/http_transport_none.cc
new file mode 100644
index 0000000..f3e5246
--- /dev/null
+++ b/util/net/http_transport_none.cc
@@ -0,0 +1,14 @@
+// Bloom keeps every crash report on the machine that wrote it: this build has no HTTP transport,
+// so the handler cannot upload a report even when it is given an address. The upload thread
+// treats a missing transport as a permanent failure and leaves the report in the database.
+
+#include "util/net/http_transport.h"
+
+namespace crashpad {
+
+// static
+std::unique_ptr<HTTPTransport> HTTPTransport::Create() {
+  return nullptr;
+}
+
+}  // namespace crashpad
