         // Copy pixels from frame to input_pic, then repeat the last column and row into the
-        // padding, which the conformance window crops but prediction still reads.
+        // padding, which the conformance window crops but prediction still reads. Kvazaar's
+        // samples are kvz_pixel: one byte in the 8-bit build, two in the 10-bit build.
         {
             const int padded_width  = FFALIGN(frame->width, 8);
             const int padded_height = FFALIGN(frame->height, 8);
+            const int bytes         = sizeof(kvz_pixel);
             uint8_t *dst[4] = {
-                input_pic->data[0],
-                input_pic->data[1],
-                input_pic->data[2],
+                (uint8_t *)input_pic->data[0],
+                (uint8_t *)input_pic->data[1],
+                (uint8_t *)input_pic->data[2],
                 NULL,
             };
             int dst_linesizes[4] = {
-              padded_width,
-              padded_width / 2,
-              padded_width / 2,
+              padded_width * bytes,
+              padded_width / 2 * bytes,
+              padded_width / 2 * bytes,
               0
             };
             av_image_copy2(dst, dst_linesizes,
@@ -232,13 +255,16 @@
                 const int width  = frame->width >> shift;
                 const int height = frame->height >> shift;
                 const int rows   = padded_height >> shift;
-                const int stride = dst_linesizes[plane];
-                for (int y = 0; y < height; y++)
-                    memset(dst[plane] + y * stride + width,
-                           dst[plane][y * stride + width - 1], stride - width);
+                const int stride = padded_width >> shift;
+                kvz_pixel *const samples = input_pic->data[plane];
+                for (int y = 0; y < height; y++) {
+                    kvz_pixel *const row = samples + y * stride;
+                    for (int x = width; x < stride; x++)
+                        row[x] = row[width - 1];
+                }
                 for (int y = height; y < rows; y++)
-                    memcpy(dst[plane] + y * stride,
