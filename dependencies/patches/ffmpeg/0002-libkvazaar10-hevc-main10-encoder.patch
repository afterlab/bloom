+/* LIBKVAZAAR_BIT_DEPTH selects the Kvazaar build this file wraps: 8 (libkvazaar, HEVC Main) or
+ * 10 (libkvazaar10.c, HEVC Main 10). Kvazaar fixes its sample depth when it is compiled, so the
+ * 10-bit library is a separate build whose symbols carry a kvz10_ prefix. */
+#ifndef LIBKVAZAAR_BIT_DEPTH
+#define LIBKVAZAAR_BIT_DEPTH 8
+#endif
+#if LIBKVAZAAR_BIT_DEPTH == 10
+#include <kvazaar10/kvazaar10.h>
+#define LIBKVAZAAR_NAME       "libkvazaar10"
+#define LIBKVAZAAR_LONG_NAME  "libkvazaar H.265 / HEVC Main 10"
+#define LIBKVAZAAR_PIX_FMT    AV_PIX_FMT_YUV420P10
+#define LIBKVAZAAR_ENCODER    ff_libkvazaar10_encoder
+#else
 #include <kvazaar.h>
+#define LIBKVAZAAR_NAME       "libkvazaar"
+#define LIBKVAZAAR_LONG_NAME  "libkvazaar H.265 / HEVC"
+#define LIBKVAZAAR_PIX_FMT    AV_PIX_FMT_YUV420P
+#define LIBKVAZAAR_ENCODER    ff_libkvazaar_encoder
+#endif
+#if KVZ_BIT_DEPTH != LIBKVAZAAR_BIT_DEPTH
+#error "the Kvazaar header does not match LIBKVAZAAR_BIT_DEPTH"
+#endif
 #include <stdint.h>
 #include <string.h>
 
@@ -51,7 +72,7 @@
 static av_cold int libkvazaar_init(AVCodecContext *avctx)
 {
     LibkvazaarContext *const ctx = avctx->priv_data;
-    const kvz_api *const api = ctx->api = kvz_api_get(8);
+    const kvz_api *const api = ctx->api = kvz_api_get(LIBKVAZAAR_BIT_DEPTH);
     kvz_config *cfg = NULL;
     kvz_encoder *enc = NULL;
 
