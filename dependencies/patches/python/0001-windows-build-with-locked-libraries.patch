+/* The Windows project includes the decimal library through a header with this name, which the
+ * separate mpdecimal releases have and the copy CPython carries does not. This one hands over
+ * to the carried header, which serves the Visual Studio compiler itself, so Windows builds the
+ * same decimal library as Linux and macOS. */
+#include "mpdecimal.h"
