# Script mode (cmake -P): writes a C++ source that embeds text files as byte arrays, so the files
# travel inside the binary on every platform without string-literal length limits.
#   -DOUTPUT=<file.cpp> -DNAMES=<name|name> -DFILES=<path|path>
# The generated source defines bloom::mcp::embeddedGuides() (src/mcp/embedded_guides.hpp).
if(NOT DEFINED OUTPUT OR NOT DEFINED NAMES OR NOT DEFINED FILES)
    message(FATAL_ERROR "BloomEmbedText.cmake needs OUTPUT, NAMES and FILES")
endif()
string(REPLACE "|" ";" NAMES "${NAMES}")
string(REPLACE "|" ";" FILES "${FILES}")
list(LENGTH NAMES name_count)
list(LENGTH FILES file_count)
if(NOT name_count EQUAL file_count)
    message(FATAL_ERROR "BloomEmbedText.cmake needs one name per file")
endif()
set(source "// Generated by cmake/BloomEmbedText.cmake. Do not edit.\n")
string(APPEND source "#include \"embedded_guides.hpp\"\n\n#include <array>\n\n")
string(APPEND source "namespace bloom::mcp {\nnamespace {\n")
set(rows "")
math(EXPR last "${file_count} - 1")
foreach(index RANGE ${last})
    list(GET NAMES ${index} name)
    list(GET FILES ${index} file)
    file(READ "${file}" bytes HEX)
    string(LENGTH "${bytes}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
    string(APPEND source "constexpr unsigned char kGuide${index}[] = {${bytes}0x00};\n")
    string(APPEND rows "    EmbeddedGuide{\"${name}\", std::string_view(reinterpret_cast<const char*>(kGuide${index}), ${size})},\n")
endforeach()
string(APPEND source "const std::array kGuides{\n${rows}};\n} // namespace\n\n")
string(APPEND source "std::span<const EmbeddedGuide> embeddedGuides() noexcept { return kGuides; }\n\n")
string(APPEND source "} // namespace bloom::mcp\n")
file(WRITE "${OUTPUT}.tmp" "${source}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
