# A CTest file in the form CMake writes, for bloom.quality.test_private_home_rejects.
add_test("fixture.own-home" "/bin/true")
set_tests_properties("fixture.own-home" PROPERTIES  ENVIRONMENT "HOME=/build/test-home/fixture.own-home;CFFIXED_USER_HOME=/build/test-home/fixture.own-home;A=1" LABELS "unit" TIMEOUT "30")
add_test("fixture.no-properties" "/bin/true")
add_test("fixture.no-home" "/bin/true")
set_tests_properties("fixture.no-home" PROPERTIES  ENVIRONMENT "XDG_CACHE_HOME=/tmp/cache" LABELS "unit" TIMEOUT "30")
add_test("fixture.another-home" "/bin/true")
set_tests_properties("fixture.another-home" PROPERTIES  ENVIRONMENT "HOME=/build/test-home/fixture.own-home;CFFIXED_USER_HOME=/build/test-home/fixture.own-home" LABELS "unit" TIMEOUT "30")
add_test("fixture.home-elsewhere" "/bin/true")
set_tests_properties("fixture.home-elsewhere" PROPERTIES  ENVIRONMENT "HOME=/elsewhere/home;CFFIXED_USER_HOME=/elsewhere/home" LABELS "unit" TIMEOUT "30")
add_test("fixture.no-fixed-home" "/bin/true")
set_tests_properties("fixture.no-fixed-home" PROPERTIES  ENVIRONMENT "HOME=/build/test-home/fixture.no-fixed-home" LABELS "unit" TIMEOUT "30")
add_test("fixture.other-fixed-home" "/bin/true")
set_tests_properties("fixture.other-fixed-home" PROPERTIES  ENVIRONMENT "HOME=/build/test-home/fixture.other-fixed-home;CFFIXED_USER_HOME=/elsewhere/home" LABELS "unit" TIMEOUT "30")
add_test("fixture.replaced-later" "/bin/true")
set_tests_properties("fixture.replaced-later" PROPERTIES  ENVIRONMENT "HOME=/build/test-home/fixture.replaced-later;CFFIXED_USER_HOME=/build/test-home/fixture.replaced-later;HOME=/elsewhere/home" LABELS "unit" TIMEOUT "30")
subdirs("sub")
