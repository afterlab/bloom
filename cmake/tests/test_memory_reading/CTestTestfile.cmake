# A CTest file in the form CMake writes, for bloom.quality.test_memory_reading_rejects.
add_test("fixture.fixed" "/bin/true")
set_tests_properties("fixture.fixed" PROPERTIES  ENVIRONMENT "A=1;BLOOM_TEST_FIXED_MEMORY_READING=17179869184,8589934592,8589934592;B=2" LABELS "gpu;unit" TIMEOUT "30")
add_test("fixture.live-stress" "/bin/true")
set_tests_properties("fixture.live-stress" PROPERTIES  ENVIRONMENT "BLOOM_TEST_LIVE_MEMORY=measures the real card" LABELS "gpu;stress" TIMEOUT "600")
add_test("fixture.gpu-unstated" "/bin/true")
set_tests_properties("fixture.gpu-unstated" PROPERTIES  ENVIRONMENT "QT_QPA_PLATFORM=offscreen" LABELS "gpu;unit" TIMEOUT "30")
add_test("fixture.no-properties" "/bin/true")
add_test("fixture.live-default-suite" "/bin/true")
set_tests_properties("fixture.live-default-suite" PROPERTIES  ENVIRONMENT "BLOOM_TEST_LIVE_MEMORY=measures the real card" LABELS "gpu" TIMEOUT "30")
add_test("fixture.stress-unnamed" "/bin/true")
set_tests_properties("fixture.stress-unnamed" PROPERTIES  LABELS "gpu;stress" TIMEOUT "600")
add_test("fixture.empty-reason" "/bin/true")
set_tests_properties("fixture.empty-reason" PROPERTIES  ENVIRONMENT "BLOOM_TEST_LIVE_MEMORY=  " LABELS "stress" TIMEOUT "600")
add_test("fixture.empty-reading" "/bin/true")
set_tests_properties("fixture.empty-reading" PROPERTIES  ENVIRONMENT "BLOOM_TEST_FIXED_MEMORY_READING=" LABELS "gpu" TIMEOUT "30")
if(CTEST_CONFIGURATION_TYPE MATCHES "^([Rr][Ee][Vv][Ii][Ee][Ww])$")
  add_test("fixture.other-configuration" "/bin/true")
  set_tests_properties("fixture.other-configuration" PROPERTIES  LABELS "gpu" TIMEOUT "30")
else()
  add_test("fixture.other-configuration" NOT_AVAILABLE)
endif()
subdirs("sub")
