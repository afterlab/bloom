# Run by ctest as the registered test: each variable the registration named is set on its own.
cmake_minimum_required(VERSION 3.25)
set(failures "")
foreach(pair IN ITEMS "BLOOM_ENV_A|1" "QT_SCALE_FACTOR|2" "BLOOM_ENV_B|2")
    string(REPLACE "|" ";" pair "${pair}")
    list(GET pair 0 name)
    list(GET pair 1 wanted)
    if(NOT "$ENV{${name}}" STREQUAL wanted)
        string(APPEND failures "\n${name} is '$ENV{${name}}', wanted '${wanted}'")
    endif()
endforeach()
# A value that is a list keeps its semicolon.
if(NOT "$ENV{BLOOM_ENV_LIST}" STREQUAL "one;two")
    string(APPEND failures "\nBLOOM_ENV_LIST is '$ENV{BLOOM_ENV_LIST}', wanted 'one;two'")
endif()
if(failures)
    message(FATAL_ERROR "the test did not get its environment:${failures}")
endif()
message(STATUS "each variable arrived on its own")
