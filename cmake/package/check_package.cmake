# Checks that a Bloom package needs nothing but itself and the operating system.
#
#   cmake -DPACKAGE=<package root; on macOS the path of Bloom.app>
#         [-DCOMPLETE=ON] [-DRUN=ON -DWORK=<empty work directory>]
#         [-DBASE_LIBRARIES=<linux-base-libraries.txt>] [-DONLY=<rule>...]
#         [-DFLOOR=<family>=<version>...]
#         -P check_package.cmake
#
# One script for the three operating systems; the rules are the same and each has one part per
# system (the layout is cmake/BloomPackageLayout.cmake's).
#
#   contents    (with COMPLETE) The package holds everything a release package must: the
#               programs, the workers, the shader tools, the carried interpreter with its standard
#               library, numpy and Bloom's Python package, the locked Qt with the platform
#               plugins, the dependency lock, and for every component the lock builds for this
#               system exactly the license files the lock names, byte for byte.
#               Without COMPLETE the package is a developer's (the host's Qt or Python) and only
#               the next rule applies.
#
#   resolution  Every program and library in the package is read (readelf, otool, dumpbin). The
#               check fails when one of them loads a library that is neither inside the package,
#               where the loader would look for it, nor a declared part of the operating system;
#               or carries a library search path that leads outside the package.
#                 Linux    declared: the names in BASE_LIBRARIES. Looked for through the
#                          file's own search path ($ORIGIN-relative).
#                 macOS    declared: /usr/lib and /System. Also fails on a file built for a
#                          newer system than the bundle's LSMinimumSystemVersion.
#                 Windows  declared: the libraries of the Windows system directory, except the
#                          Visual C++ runtime, which is not part of Windows and must be inside.
#                          Looked for beside the file and, for a library, beside the programs.
#
#   run         (with RUN) The package's own bloom-cli runs
#               tests/fixtures/scripting/package_loaded_images.py in the carried interpreter,
#               which uses every carried module and then starts the packaged
#               application without a window. Both report every image they loaded. The check
#               fails when an image came from outside the package and is not a declared part of
#               the operating system (on Linux: a named base library, or a library the loader
#               records one of those as having asked for), or when a library the package carries
#               was loaded from somewhere else.
#               The run has its own settings, data and cache directories under WORK and never
#               reads or changes Bloom's own (src/ui/include/bloom/ui/application_identity.hpp).
#               On macOS and Windows Qt also makes a per-user cache or data folder named after
#               the check (BloomPackageCheck) where the system keeps such folders; the check
#               removes it when the run is over.
#               On Linux no GPU driver is offered to it, so that what it loads does not depend on
#               the machine's driver.
#
#               With FLOOR (Linux), also fails on a file that needs a newer version of a C or
#               C++ library symbol than the oldest system the package is for has, for example
#               -DFLOOR=GLIBC=2.35;GLIBCXX=3.4.30;CXXABI=1.3.13 for Ubuntu 22.04. A package
#               built on a developer's newer system is checked without it.
#
# ONLY limits the check to the named rules (the check's own test uses it).
#
# A package that passes starts on a computer that has none of the build machine's software.
cmake_minimum_required(VERSION 3.25)
# file(REAL_PATH) follows links before it collapses "..", as the loader does.
if(POLICY CMP0152)
    cmake_policy(SET CMP0152 NEW)
endif()

if(NOT PACKAGE OR NOT IS_DIRECTORY "${PACKAGE}")
    message(FATAL_ERROR "check_package.cmake: PACKAGE is not a directory: '${PACKAGE}'")
endif()
file(REAL_PATH "${PACKAGE}" package)
get_filename_component(package_name "${package}" NAME)
if(NOT ONLY)
    set(ONLY contents resolution run)
endif()
set(failures "")

# --- Layout (cmake/BloomPackageLayout.cmake) ---------------------------------------------------
if(CMAKE_HOST_APPLE)
    set(system macos)
    set(programs "${package}/Contents/MacOS")
    set(libraries "${package}/Contents/Frameworks")
    set(color "${package}/Contents/MacOS")
    set(media "${package}/Contents/libexec/bloom/media")
    set(python "${package}/Contents/Resources/python")
    set(bloom_python "${package}/Contents/Resources/bloom-python")
    set(records "${package}/Contents/Resources")
    set(qt_plugins "${package}/Contents/PlugIns")
    set(suffix "")
elseif(CMAKE_HOST_WIN32)
    set(system windows)
    set(programs "${package}")
    set(libraries "${package}")
    set(color "${package}")
    set(media "${package}/media")
    set(python "${package}/python")
    set(bloom_python "${package}/bloom-python")
    set(records "${package}")
    set(qt_plugins "${package}/qt/plugins")
    set(suffix ".exe")
else()
    set(system linux)
    set(programs "${package}/bin")
    set(libraries "${package}/lib")
    set(color "${package}/libexec/bloom")
    set(media "${package}/libexec/bloom/media")
    set(python "${package}/share/bloom/python")
    set(bloom_python "${package}/share/bloom/bloom-python")
    set(records "${package}/share/bloom")
    set(qt_plugins "${package}/lib/qt/plugins")
    set(suffix "")
endif()

# Records one failure; the arguments are joined into its text.
function(bloom_fail)
    string(CONCAT text ${ARGV})
    list(APPEND failures "${text}")
    set(failures "${failures}" PARENT_SCOPE)
endfunction()

function(bloom_shown path variable)
    file(RELATIVE_PATH shown "${package}" "${path}")
    set(${variable} "${shown}" PARENT_SCOPE)
endfunction()

function(bloom_require path what)
    if(NOT EXISTS "${path}")
        bloom_shown("${path}" shown)
        list(APPEND failures "the package has no ${what} (${shown})")
        set(failures "${failures}" PARENT_SCOPE)
    endif()
endfunction()

# Runs a tool that reads one file; its output as a list of lines.
function(bloom_tool variable)
    execute_process(COMMAND ${ARGN} OUTPUT_VARIABLE output RESULT_VARIABLE result
                    ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${ARGN} failed: ${error}")
    endif()
    string(REPLACE ";" "\;" output "${output}")
    string(REGEX REPLACE "\r?\n" ";" output "${output}")
    set(${variable} "${output}" PARENT_SCOPE)
endfunction()

# TRUE when the path, links followed, is inside the package. A path that does not exist is
# judged by where it would be.
function(bloom_inside path variable)
    set(${variable} FALSE PARENT_SCOPE)
    if(path STREQUAL "")
        return()
    endif()
    if(EXISTS "${path}")
        file(REAL_PATH "${path}" real)
    else()
        cmake_path(SET real NORMALIZE "${path}")
    endif()
    cmake_path(IS_PREFIX package "${real}" NORMALIZE inside)
    set(${variable} ${inside} PARENT_SCOPE)
endfunction()

# --- The declared system libraries of Linux ----------------------------------------------------
set(base_names "")
set(base_prefixes "")
if(system STREQUAL "linux")
    if(NOT BASE_LIBRARIES)
        set(BASE_LIBRARIES "${CMAKE_CURRENT_LIST_DIR}/linux-base-libraries.txt")
    endif()
    file(STRINGS "${BASE_LIBRARIES}" lines)
    foreach(line IN LISTS lines)
        string(STRIP "${line}" line)
        if(line STREQUAL "" OR line MATCHES "^#")
            continue()
        endif()
        if(line MATCHES "^(.+)\\*$")
            list(APPEND base_prefixes "${CMAKE_MATCH_1}")
        else()
            list(APPEND base_names "${line}")
        endif()
    endforeach()
endif()

# TRUE when a library name a program asks for is a declared system library.
function(bloom_base_name name variable)
    set(${variable} FALSE PARENT_SCOPE)
    if(name IN_LIST base_names)
        set(${variable} TRUE PARENT_SCOPE)
        return()
    endif()
    foreach(prefix IN LISTS base_prefixes)
        string(FIND "${name}" "${prefix}" position)
        if(position EQUAL 0)
            set(${variable} TRUE PARENT_SCOPE)
            return()
        endif()
    endforeach()
endfunction()

# TRUE when a loaded file is the library programs ask for as `name`: the file is that name, or
# that name with a longer version (libz.so.1 is loaded as libz.so.1.3.1).
function(bloom_file_is leaf name variable)
    set(${variable} FALSE PARENT_SCOPE)
    if(leaf STREQUAL name)
        set(${variable} TRUE PARENT_SCOPE)
        return()
    endif()
    string(LENGTH "${name}." length)
    string(LENGTH "${leaf}" leaf_length)
    if(leaf_length GREATER length)
        string(SUBSTRING "${leaf}" 0 ${length} start)
        if(start STREQUAL "${name}.")
            set(${variable} TRUE PARENT_SCOPE)
        endif()
    endif()
endfunction()

# TRUE when a file loaded from outside the package is a declared system library of Linux by its
# own name.
function(bloom_base_file path variable)
    set(${variable} FALSE PARENT_SCOPE)
    get_filename_component(leaf "${path}" NAME)
    foreach(name IN LISTS base_names)
        bloom_file_is("${leaf}" "${name}" is)
        if(is)
            set(${variable} TRUE PARENT_SCOPE)
            return()
        endif()
    endforeach()
    # A distribution may keep a library under another file name and give it the name programs
    # ask for as a link (libgcc_s.so.1 -> libgcc_s-<version>.so.1): the file is the declared
    # library when that link, beside it, leads to it.
    get_filename_component(directory "${path}" DIRECTORY)
    if(EXISTS "${path}")
        file(REAL_PATH "${path}" real)
        foreach(name IN LISTS base_names)
            if(IS_SYMLINK "${directory}/${name}")
                file(REAL_PATH "${directory}/${name}" target)
                if(target STREQUAL real)
                    set(${variable} TRUE PARENT_SCOPE)
                    return()
                endif()
            endif()
        endforeach()
    endif()
    foreach(prefix IN LISTS base_prefixes)
        if(prefix MATCHES "/")
            # A directory the C library loads modules from (gconv/).
            string(FIND "${path}" "/${prefix}" position)
            if(NOT position EQUAL -1)
                set(${variable} TRUE PARENT_SCOPE)
                return()
            endif()
        else()
            string(FIND "${leaf}" "${prefix}" position)
            if(position EQUAL 0)
                set(${variable} TRUE PARENT_SCOPE)
                return()
            endif()
        endif()
    endforeach()
endfunction()

# The library names an ELF file asks for and its search path entries.
function(bloom_elf_needs file needed_variable search_variable)
    bloom_tool(lines readelf -d "${file}")
    set(needed "")
    set(search "")
    foreach(line IN LISTS lines)
        if(line MATCHES "\\(NEEDED\\).*\\[([^]]+)\\]")
            list(APPEND needed "${CMAKE_MATCH_1}")
        elseif(line MATCHES "\\((RUNPATH|RPATH)\\).*\\[([^]]*)\\]")
            string(REPLACE ":" ";" entries "${CMAKE_MATCH_2}")
            list(APPEND search ${entries})
        endif()
    endforeach()
    set(${needed_variable} "${needed}" PARENT_SCOPE)
    set(${search_variable} "${search}" PARENT_SCOPE)
endfunction()

# --- contents ----------------------------------------------------------------------------------
if(COMPLETE AND "contents" IN_LIST ONLY)
    bloom_require("${programs}/Bloom${suffix}" "application")
    bloom_require("${programs}/bloom-cli${suffix}" "bloom-cli")
    bloom_require("${programs}/bloom-mcp${suffix}" "bloom-mcp")
    bloom_require("${color}/bloom-color-worker${suffix}" "color worker")
    bloom_require("${media}/ffmpeg-v1/bloom-media-worker${suffix}" "media worker")
    if(system STREQUAL "macos")
        bloom_require("${media}/videotoolbox-v1/bloom-media-videotoolbox-worker"
                      "VideoToolbox media worker")
    endif()
    bloom_require("${programs}/bloom-gpu-tools/glslangValidator${suffix}" "shader compiler")
    bloom_require("${programs}/bloom-gpu-tools/spirv-val${suffix}" "shader validator")

    # The carried interpreter.
    if(system STREQUAL "windows")
        file(GLOB interpreter "${libraries}/python3??.dll")
        set(standard "${python}/Lib")
        file(GLOB ssl "${python}/DLLs/_ssl*.pyd")
    else()
        file(GLOB standard "${python}/lib/python3.*")
        get_filename_component(version "${standard}" NAME)
        if(system STREQUAL "macos")
            set(interpreter "${libraries}/lib${version}.dylib")
        else()
            set(interpreter "${libraries}/lib${version}.so.1.0")
        endif()
        file(GLOB ssl "${standard}/lib-dynload/_ssl.*.so")
    endif()
    if(NOT standard OR NOT EXISTS "${standard}/os.py")
        list(APPEND failures "the package has no Python standard library")
    else()
        if(NOT interpreter OR NOT EXISTS "${interpreter}")
            list(APPEND failures "the package has no interpreter library")
        endif()
        if(NOT ssl)
            list(APPEND failures "the carried standard library has no ssl module")
        endif()
        if(NOT EXISTS "${standard}/site-packages/numpy/__init__.py")
            list(APPEND failures "the carried interpreter has no numpy in its site-packages")
        endif()
    endif()
    bloom_require("${bloom_python}/bloom/__init__.py" "Bloom Python package")

    # The locked Qt.
    if(system STREQUAL "macos")
        bloom_require("${libraries}/QtCore.framework" "Qt")
        bloom_require("${qt_plugins}/platforms/libqcocoa.dylib" "Qt platform plugin")
        bloom_require("${qt_plugins}/platforms/libqoffscreen.dylib" "Qt offscreen plugin")
    elseif(system STREQUAL "windows")
        bloom_require("${libraries}/Qt6Core.dll" "Qt")
        bloom_require("${qt_plugins}/platforms/qwindows.dll" "Qt platform plugin")
        bloom_require("${qt_plugins}/platforms/qoffscreen.dll" "Qt offscreen plugin")
        bloom_require("${programs}/qt.conf" "Qt plugin directory record")
    else()
        bloom_require("${package}/lib/qt/lib/libQt6Core.so.6" "Qt")
        bloom_require("${qt_plugins}/platforms/libqxcb.so" "Qt X11 platform plugin")
        bloom_require("${qt_plugins}/platforms/libqwayland.so" "Qt Wayland platform plugin")
        bloom_require("${qt_plugins}/platforms/libqoffscreen.so" "Qt offscreen plugin")
    endif()

    # The records: Bloom's own, the lock, and the license files the lock names.
    bloom_require("${records}/LICENSE" "Bloom license")
    bloom_require("${records}/NOTICE" "Bloom notice")
    bloom_require("${records}/THIRD_PARTY_NOTICES.md" "third-party notices")
    bloom_require("${records}/licenses/qt/NOTICE.txt" "Qt notice")
    bloom_require("${records}/licenses/qt/texts/LGPL-3.0-only.txt" "LGPL text")
    set(lock_file "${records}/dependencies.lock.json")
    if(NOT EXISTS "${lock_file}")
        list(APPEND failures "the package has no dependency lock")
    else()
        file(READ "${lock_file}" lock)
        set(profile "")
        string(JSON profile_count LENGTH "${lock}" profiles)
        math(EXPR profile_last "${profile_count} - 1")
        foreach(index RANGE 0 ${profile_last})
            string(JSON profile_system GET "${lock}" profiles ${index} target operatingSystem)
            if(profile_system STREQUAL system)
                string(JSON profile GET "${lock}" profiles ${index} id)
            endif()
        endforeach()
        if(NOT profile)
            list(APPEND failures "the carried dependency lock has no ${system} profile")
        endif()
        set(license_count 0)
        string(JSON component_count LENGTH "${lock}" components)
        math(EXPR component_last "${component_count} - 1")
        foreach(index RANGE 0 ${component_last})
            string(JSON name GET "${lock}" components ${index} name)
            set(built FALSE)
            string(JSON build_count LENGTH "${lock}" components ${index} profileBuilds)
            math(EXPR build_last "${build_count} - 1")
            foreach(build RANGE 0 ${build_last})
                string(JSON build_profile GET "${lock}" components ${index} profileBuilds
                       ${build} profileId)
                if(build_profile STREQUAL profile)
                    set(built TRUE)
                endif()
            endforeach()
            if(NOT built)
                continue()
            endif()
            set(named 0)
            foreach(kind IN ITEMS licenseFiles copyrightFiles noticeFiles)
                string(JSON file_count LENGTH "${lock}" components ${index} license ${kind})
                if(file_count EQUAL 0)
                    continue()
                endif()
                math(EXPR file_last "${file_count} - 1")
                foreach(file RANGE 0 ${file_last})
                    string(JSON path GET "${lock}" components ${index} license ${kind} ${file}
                           path)
                    string(JSON digest GET "${lock}" components ${index} license ${kind} ${file}
                           sha256)
                    math(EXPR named "${named} + 1")
                    string(REGEX REPLACE "^dependencies/licenses/[^/]+/" "" relative "${path}")
                    set(carried "${records}/licenses/${name}/${relative}")
                    if(NOT EXISTS "${carried}")
                        list(APPEND failures
                             "no license file licenses/${name}/${relative} for ${name}")
                        continue()
                    endif()
                    file(SHA256 "${carried}" actual)
                    if(NOT "sha256:${actual}" STREQUAL digest)
                        bloom_fail("licenses/${name}/${relative} is not the file the dependency "
                                   "lock records")
                    endif()
                    math(EXPR license_count "${license_count} + 1")
                endforeach()
            endforeach()
            if(named EQUAL 0)
                list(APPEND failures "the dependency lock names no license file for ${name}")
            endif()
        endforeach()
    endif()
endif()

# The distribution libraries a Linux package carries, as its own inventory lists them.
if(COMPLETE AND "contents" IN_LIST ONLY AND system STREQUAL "linux")
    set(inventory_file "${records}/linux-runtime-packages.json")
    if(NOT EXISTS "${inventory_file}")
        list(APPEND failures "the package has no inventory of its distribution libraries")
    else()
        file(READ "${inventory_file}" inventory)
        string(JSON inventory_count LENGTH "${inventory}" packages)
        math(EXPR inventory_last "${inventory_count} - 1")
        foreach(index RANGE 0 ${inventory_last})
            string(JSON name GET "${inventory}" packages ${index} package)
            string(JSON library GET "${inventory}" packages ${index} library name)
            string(JSON digest GET "${inventory}" packages ${index} copyright sha256)
            if(NOT EXISTS "${package}/lib/qt/lib/${library}")
                list(APPEND failures "no ${library} (${name}) beside Qt")
            endif()
            set(carried "${records}/licenses/${name}/copyright")
            if(NOT EXISTS "${carried}")
                list(APPEND failures "no license file licenses/${name}/copyright for ${name}")
            else()
                file(SHA256 "${carried}" actual)
                if(NOT actual STREQUAL digest)
                    bloom_fail("licenses/${name}/copyright is not the file the package's "
                               "inventory records")
                endif()
            endif()
        endforeach()
    endif()
endif()

# --- resolution --------------------------------------------------------------------------------
set(floors ${FLOOR})
foreach(floor IN LISTS floors)
    if(NOT floor MATCHES "^[A-Z]+=[0-9][0-9.]*$")
        message(FATAL_ERROR "check_package.cmake: FLOOR entry '${floor}' is not <family>=<version>")
    endif()
endforeach()
set(count 0)
set(carried_names "")
if("resolution" IN_LIST ONLY OR "run" IN_LIST ONLY)
    file(GLOB_RECURSE files LIST_DIRECTORIES false "${package}/*")
endif()

if(system STREQUAL "linux" AND ("resolution" IN_LIST ONLY OR "run" IN_LIST ONLY))
    set(binaries "")
    foreach(file IN LISTS files)
        if(IS_SYMLINK "${file}")
            get_filename_component(leaf "${file}" NAME)
            if(leaf MATCHES "\\.so(\\.|$)")
                list(APPEND carried_names "${leaf}")
            endif()
            continue()
        endif()
        file(READ "${file}" magic LIMIT 4 HEX)
        if(NOT magic STREQUAL "7f454c46")
            continue()
        endif()
        list(APPEND binaries "${file}")
        get_filename_component(leaf "${file}" NAME)
        if(leaf MATCHES "\\.so(\\.|$)")
            list(APPEND carried_names "${leaf}")
        endif()
    endforeach()
    list(LENGTH binaries count)
    if("resolution" IN_LIST ONLY)
        foreach(file IN LISTS binaries)
            bloom_shown("${file}" shown)
            get_filename_component(directory "${file}" DIRECTORY)
            bloom_elf_needs("${file}" needed search)
            # The oldest system the package is for: no file may need a newer version of a
            # symbol of the C or C++ library than that system's has.
            if(floors)
                execute_process(COMMAND readelf -V -W "${file}"
                                OUTPUT_VARIABLE versions ERROR_QUIET)
                foreach(floor IN LISTS floors)
                    string(REGEX MATCH "^([A-Z]+)=(.+)$" matched "${floor}")
                    set(family "${CMAKE_MATCH_1}")
                    set(limit "${CMAKE_MATCH_2}")
                    string(REGEX MATCHALL "Name: ${family}_[0-9][0-9.]*" found "${versions}")
                    list(REMOVE_DUPLICATES found)
                    foreach(entry IN LISTS found)
                        string(REGEX REPLACE "^Name: ${family}_" "" version "${entry}")
                        if(version VERSION_GREATER limit)
                            bloom_fail("${shown}: needs ${family}_${version}; the oldest "
                                       "system the package is for has ${family}_${limit}")
                        endif()
                    endforeach()
                endforeach()
            endif()
            set(directories "")
            foreach(entry IN LISTS search)
                if(entry STREQUAL "")
                    continue()
                endif()
                if(NOT entry MATCHES "^\\$(ORIGIN|\\{ORIGIN\\})(/.*)?$")
                    list(APPEND failures
                         "${shown}: library search path outside the package: ${entry}")
                    continue()
                endif()
                set(expanded "${directory}${CMAKE_MATCH_2}")
                bloom_inside("${expanded}" inside)
                if(NOT inside)
                    list(APPEND failures
                         "${shown}: library search path outside the package: ${entry}")
                    continue()
                endif()
                list(APPEND directories "${expanded}")
            endforeach()
            foreach(name IN LISTS needed)
                set(found FALSE)
                foreach(search_directory IN LISTS directories)
                    if(EXISTS "${search_directory}/${name}")
                        bloom_inside("${search_directory}/${name}" found)
                        if(found)
                            break()
                        endif()
                    endif()
                endforeach()
                if(found)
                    continue()
                endif()
                bloom_base_name("${name}" base)
                if(base AND NOT name IN_LIST carried_names)
                    continue()
                endif()
                if(name IN_LIST carried_names)
                    bloom_fail("${shown}: loads ${name}, which the package carries but this "
                               "file's search path does not reach")
                else()
                    bloom_fail("${shown}: loads ${name}, which is neither in the package nor a "
                               "declared system library")
                endif()
            endforeach()
        endforeach()
    endif()
elseif(system STREQUAL "windows" AND ("resolution" IN_LIST ONLY OR "run" IN_LIST ONLY))
    # Only the resolution rule reads the files; a run on a computer without the build tools
    # needs none of them.
    if("resolution" IN_LIST ONLY)
        find_program(BLOOM_DUMPBIN dumpbin REQUIRED)
    endif()
    file(TO_CMAKE_PATH "$ENV{SystemRoot}/System32" system_directory)
    set(binaries "")
    foreach(file IN LISTS files)
        string(TOLOWER "${file}" lower)
        if(lower MATCHES "\\.(exe|dll|pyd)$")
            list(APPEND binaries "${file}")
            get_filename_component(leaf "${lower}" NAME)
            list(APPEND carried_names "${leaf}")
        endif()
    endforeach()
    list(LENGTH binaries count)
    if("resolution" IN_LIST ONLY)
        foreach(file IN LISTS binaries)
            bloom_shown("${file}" shown)
            get_filename_component(directory "${file}" DIRECTORY)
            string(TOLOWER "${file}" lower)
            bloom_tool(lines "${BLOOM_DUMPBIN}" /nologo /dependents "${file}")
            foreach(line IN LISTS lines)
                if(NOT line MATCHES "^ +([^ ]+\\.[Dd][Ll][Ll])$")
                    continue()
                endif()
                set(name "${CMAKE_MATCH_1}")
                string(TOLOWER "${name}" lower_name)
                # An API set is a name of Windows itself, not a file.
                if(lower_name MATCHES "^(api-ms-win-|ext-ms-)")
                    continue()
                endif()
                if(EXISTS "${directory}/${name}")
                    continue()
                endif()
                # A library is loaded into a program, and Windows looks beside the program.
                if(NOT lower MATCHES "\\.exe$" AND EXISTS "${programs}/${name}")
                    continue()
                endif()
                if(lower_name MATCHES "^(vcruntime|msvcp|concrt|vcomp)[0-9]")
                    bloom_fail("${shown}: loads ${name}, the Visual C++ runtime, which is not "
                               "beside it in the package")
                elseif(NOT EXISTS "${system_directory}/${name}")
                    bloom_fail("${shown}: loads ${name}, which is neither in the package nor part "
                               "of Windows")
                endif()
            endforeach()
        endforeach()
    endif()
elseif(system STREQUAL "macos" AND "resolution" IN_LIST ONLY)
    set(contents "${package}/Contents")
    function(bloom_plist key variable)
        execute_process(COMMAND /usr/libexec/PlistBuddy -c "Print ${key}"
                                "${contents}/Info.plist"
                        OUTPUT_VARIABLE value OUTPUT_STRIP_TRAILING_WHITESPACE
                        RESULT_VARIABLE result ERROR_QUIET)
        if(NOT result EQUAL 0)
            set(value "")
        endif()
        set(${variable} "${value}" PARENT_SCOPE)
    endfunction()
    bloom_plist(LSMinimumSystemVersion minimum)
    bloom_plist(CFBundleExecutable main_name)
    if(NOT minimum)
        list(APPEND failures "Info.plist has no LSMinimumSystemVersion")
    endif()
    if(NOT main_name OR NOT EXISTS "${programs}/${main_name}")
        list(APPEND failures "the bundle's executable is missing: '${main_name}'")
    endif()
    # The bundle declares Bloom's project document, so the system offers Bloom for a project
    # file and sends it the file-open event.
    bloom_plist(":CFBundleDocumentTypes:0:LSItemContentTypes:0" document_type)
    bloom_plist(":UTExportedTypeDeclarations:0:UTTypeIdentifier" exported_type)
    bloom_plist(":UTExportedTypeDeclarations:0:UTTypeTagSpecification:public.filename-extension:0"
                extension)
    if(NOT document_type STREQUAL "org.kinetik.bloom.project"
       OR NOT exported_type STREQUAL document_type OR NOT extension STREQUAL "bloom")
        bloom_fail("Info.plist does not declare the Bloom project document type "
                   "(.bloom, org.kinetik.bloom.project)")
    endif()

    # Every Mach-O file, by its first four bytes. Per file: what it loads, its search paths, the
    # systems it was built for, and whether it is a program.
    set(load_commands LC_LOAD_DYLIB LC_LOAD_WEAK_DYLIB LC_REEXPORT_DYLIB LC_LAZY_LOAD_DYLIB)
    set(binaries "")
    set(program_indexes "")
    foreach(file IN LISTS files)
        if(IS_SYMLINK "${file}")
            continue()
        endif()
        file(READ "${file}" magic LIMIT 4 HEX)
        if(NOT magic MATCHES "^(cffaedfe|cefaedfe|feedfacf|feedface|cafebabe|cafebabf)$")
            continue()
        endif()
        set(index ${count})
        math(EXPR count "${count} + 1")
        list(APPEND binaries ${index})
        set(path_${index} "${file}")
        set(loads_${index} "")
        set(search_${index} "")
        set(systems_${index} "")
        bloom_tool(header otool -hv "${file}")
        if(header MATCHES " EXECUTE ")
            set(program_${index} TRUE)
            list(APPEND program_indexes ${index})
        else()
            set(program_${index} FALSE)
        endif()
        bloom_tool(lines otool -l "${file}")
        set(command "")
        foreach(line IN LISTS lines)
            string(STRIP "${line}" line)
            if(line MATCHES "^cmd ([A-Z_0-9]+)")
                set(command "${CMAKE_MATCH_1}")
            elseif(command IN_LIST load_commands
                   AND line MATCHES "^name (.+) \\(offset [0-9]+\\)$")
                list(APPEND loads_${index} "${CMAKE_MATCH_1}")
            elseif(command STREQUAL "LC_RPATH"
                   AND line MATCHES "^path (.+) \\(offset [0-9]+\\)$")
                list(APPEND search_${index} "${CMAKE_MATCH_1}")
            elseif(command STREQUAL "LC_BUILD_VERSION" AND line MATCHES "^minos ([0-9.]+)")
                list(APPEND systems_${index} "${CMAKE_MATCH_1}")
            elseif(command STREQUAL "LC_VERSION_MIN_MACOSX"
                   AND line MATCHES "^version ([0-9.]+)")
                list(APPEND systems_${index} "${CMAKE_MATCH_1}")
            endif()
        endforeach()
    endforeach()

    # A load or search path with @loader_path and @executable_path filled in; empty when it is
    # neither those nor absolute.
    function(bloom_expand text loader program_directory variable)
        get_filename_component(loader_directory "${loader}" DIRECTORY)
        if(text MATCHES "^@loader_path(.*)$")
            set(result "${loader_directory}${CMAKE_MATCH_1}")
        elseif(text MATCHES "^@executable_path(.*)$")
            set(result "${program_directory}${CMAKE_MATCH_1}")
        elseif(text MATCHES "^/")
            set(result "${text}")
        else()
            set(result "")
        endif()
        set(${variable} "${result}" PARENT_SCOPE)
    endfunction()

    # TRUE when the path is a file inside the bundle.
    function(bloom_file_inside path variable)
        set(${variable} FALSE PARENT_SCOPE)
        if(path STREQUAL "" OR NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
            return()
        endif()
        bloom_inside("${path}" inside)
        set(${variable} ${inside} PARENT_SCOPE)
    endfunction()

    # The directories a binary's @rpath loads are looked up in. A search path is read relative to
    # the program that is running: a program uses its own; a library is loaded by the bundle's
    # programs, so its own search paths are tried for each of them and so are each program's.
    function(bloom_search_directories index variable)
        set(directories "")
        if(program_${index})
            set(owners ${index})
        else()
            set(owners ${index} ${program_indexes})
        endif()
        foreach(owner IN LISTS owners)
            if(program_${owner})
                get_filename_component(program_directories "${path_${owner}}" DIRECTORY)
            else()
                set(program_directories "")
                foreach(program IN LISTS program_indexes)
                    get_filename_component(directory "${path_${program}}" DIRECTORY)
                    list(APPEND program_directories "${directory}")
                endforeach()
                list(REMOVE_DUPLICATES program_directories)
            endif()
            foreach(text IN LISTS search_${owner})
                foreach(program_directory IN LISTS program_directories)
                    bloom_expand("${text}" "${path_${owner}}" "${program_directory}" directory)
                    if(directory)
                        list(APPEND directories "${directory}")
                    endif()
                endforeach()
            endforeach()
        endforeach()
        list(REMOVE_DUPLICATES directories)
        set(${variable} "${directories}" PARENT_SCOPE)
    endfunction()

    foreach(index IN LISTS binaries)
        bloom_shown("${path_${index}}" name)
        if(program_${index})
            get_filename_component(program_directory "${path_${index}}" DIRECTORY)
        else()
            set(program_directory "${programs}")
        endif()
        foreach(text IN LISTS search_${index})
            if(text MATCHES "^(/usr/lib/|/System/)")
                continue()
            endif()
            bloom_expand("${text}" "${path_${index}}" "${program_directory}" directory)
            bloom_inside("${directory}" inside)
            if(NOT inside)
                list(APPEND failures "${name}: library search path outside the package: ${text}")
            endif()
        endforeach()
        foreach(load IN LISTS loads_${index})
            if(load MATCHES "^(/usr/lib/|/System/)")
                continue()
            endif()
            set(found FALSE)
            if(load MATCHES "^@rpath/(.+)$")
                set(leaf "${CMAKE_MATCH_1}")
                bloom_search_directories(${index} directories)
                foreach(directory IN LISTS directories)
                    bloom_file_inside("${directory}/${leaf}" found)
                    if(found)
                        break()
                    endif()
                endforeach()
            else()
                bloom_expand("${load}" "${path_${index}}" "${program_directory}" target)
                bloom_file_inside("${target}" found)
            endif()
            if(NOT found)
                bloom_fail("${name}: loads ${load}, which is neither in the package nor part of "
                           "the operating system")
            endif()
        endforeach()
        if(NOT systems_${index})
            list(APPEND failures "${name}: states no minimum system version")
        elseif(minimum)
            foreach(built_for IN LISTS systems_${index})
                if(built_for VERSION_GREATER minimum)
                    list(APPEND failures
                         "${name}: built for macOS ${built_for}, the bundle declares ${minimum}")
                endif()
            endforeach()
        endif()
    endforeach()
endif()

# --- run ---------------------------------------------------------------------------------------
set(image_count 0)
if(RUN AND "run" IN_LIST ONLY AND NOT failures)
    if(NOT WORK)
        message(FATAL_ERROR "check_package.cmake: RUN needs WORK, a directory for the run's own "
                            "settings, data and cache")
    endif()
    # Absolute: the packaged programs run in a directory of their own, and the application
    # takes only an absolute directory as the check's profile.
    get_filename_component(WORK "${WORK}" ABSOLUTE)
    file(REMOVE_RECURSE "${WORK}")
    file(MAKE_DIRECTORY "${WORK}/home" "${WORK}/profile" "${WORK}/no-drivers" "${WORK}/run")
    set(report "${WORK}/images.txt")
    # Beside the other scripts the carried interpreter runs.
    get_filename_component(script
        "${CMAKE_CURRENT_LIST_DIR}/../../tests/fixtures/scripting/package_loaded_images.py"
        ABSOLUTE)
    # Nothing of the build machine's setup reaches the run.
    foreach(variable IN ITEMS PYTHONHOME PYTHONPATH PYTHONSTARTUP LD_LIBRARY_PATH LD_PRELOAD
                              DYLD_LIBRARY_PATH DYLD_FRAMEWORK_PATH DYLD_INSERT_LIBRARIES
                              DYLD_FALLBACK_LIBRARY_PATH QT_PLUGIN_PATH QT_QPA_PLATFORM
                              QT_QPA_PLATFORM_PLUGIN_PATH QTDIR QT_VULKAN_LIB DISPLAY
                              WAYLAND_DISPLAY)
        unset(ENV{${variable}})
    endforeach()
    set(ENV{BLOOM_PACKAGE_CHECK_OUTPUT} "${report}")
    set(ENV{BLOOM_PACKAGE_CHECK_APPLICATION} "${programs}/Bloom${suffix}")
    # The application takes the check's profile only as an absolute directory. Checked here
    # too, so that nothing is started when it is not.
    if(NOT IS_ABSOLUTE "${WORK}/profile" OR NOT IS_DIRECTORY "${WORK}/profile")
        message(FATAL_ERROR "check_package.cmake: the profile directory '${WORK}/profile' is "
                            "not an absolute directory; nothing was started")
    endif()
    set(ENV{BLOOM_PACKAGE_CHECK_PROFILE} "${WORK}/profile")
    # Qt names two per-user folders after the organization name and asks the operating system
    # where they are, which on macOS and Windows no variable changes. The application runs
    # under the check's own organization name (application_identity.hpp), so those folders are
    # the check's and never Bloom's own, and they are removed after the run.
    set(leftovers "")
    if(system STREQUAL "macos")
        list(APPEND leftovers "$ENV{HOME}/Library/Caches/BloomPackageCheck"
                              "$ENV{HOME}/Library/Application Support/BloomPackageCheck")
    elseif(system STREQUAL "windows")
        file(TO_CMAKE_PATH "$ENV{LOCALAPPDATA}" local_data)
        file(TO_CMAKE_PATH "$ENV{APPDATA}" roaming_data)
        list(APPEND leftovers "${local_data}/BloomPackageCheck"
                              "${roaming_data}/BloomPackageCheck")
    endif()
    if(system STREQUAL "windows")
        file(TO_NATIVE_PATH "${system_directory}" native_system)
        set(ENV{PATH} "${native_system};$ENV{SystemRoot}")
        file(TO_NATIVE_PATH "${WORK}/home" native_home)
        set(ENV{LOCALAPPDATA} "${native_home}")
        set(ENV{APPDATA} "${native_home}")
    else()
        set(ENV{PATH} "/usr/bin:/bin")
        set(ENV{HOME} "${WORK}/home")
        set(ENV{XDG_CONFIG_HOME} "${WORK}/home/config")
        set(ENV{XDG_DATA_HOME} "${WORK}/home/data")
        set(ENV{XDG_CACHE_HOME} "${WORK}/home/cache")
        set(ENV{XDG_STATE_HOME} "${WORK}/home/state")
    endif()
    if(system STREQUAL "linux")
        # No GPU driver and no layer: what the run loads must not depend on the machine's.
        set(ENV{VK_DRIVER_FILES} "${WORK}/no-drivers")
        set(ENV{VK_ICD_FILENAMES} "${WORK}/no-drivers")
        set(ENV{VK_LOADER_LAYERS_DISABLE} "~all~")
        # The loader's record of which file asked for which library, one file per process.
        file(MAKE_DIRECTORY "${WORK}/loader")
        set(ENV{LD_DEBUG} "files")
        set(ENV{LD_DEBUG_OUTPUT} "${WORK}/loader/log")
    endif()
    execute_process(
        COMMAND "${programs}/bloom-cli${suffix}" run "${script}"
        WORKING_DIRECTORY "${WORK}/run"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 600)
    foreach(leftover IN LISTS leftovers)
        if(leftover MATCHES "/BloomPackageCheck$" AND IS_DIRECTORY "${leftover}")
            file(REMOVE_RECURSE "${leftover}")
        endif()
    endforeach()
    if(NOT result EQUAL 0)
        bloom_fail("bloom-cli could not run the check's script (${result}): ${output}${error}")
    endif()
    set(records_read "")
    if(EXISTS "${report}")
        file(STRINGS "${report}" records_read)
    endif()
    set(outside "")
    set(finished "")
    foreach(record IN LISTS records_read)
        if(record MATCHES "^error (.*)$")
            list(APPEND failures "the run reported: ${CMAKE_MATCH_1}")
        elseif(record MATCHES "^done (.+)$")
            list(APPEND finished "${CMAKE_MATCH_1}")
        elseif(record MATCHES "^(cli|application) (.+)$")
            set(who "${CMAKE_MATCH_1}")
            file(TO_CMAKE_PATH "${CMAKE_MATCH_2}" image)
            math(EXPR image_count "${image_count} + 1")
            bloom_inside("${image}" inside)
            if(inside)
                continue()
            endif()
            get_filename_component(leaf "${image}" NAME)
            if(system STREQUAL "windows")
                string(TOLOWER "${leaf}" leaf)
            endif()
            if(leaf IN_LIST carried_names)
                bloom_fail("${who} loaded ${image}, but the package carries its own "
                           "${leaf}")
                continue()
            endif()
            if(system STREQUAL "macos")
                if(NOT image MATCHES "^(/usr/lib/|/System/)")
                    bloom_fail("${who} loaded ${image}, which is neither in the package nor part "
                               "of the operating system")
                endif()
            elseif(system STREQUAL "windows")
                file(TO_CMAKE_PATH "$ENV{SystemRoot}" windows_directory)
                string(TOLOWER "${image}" lower_image)
                string(TOLOWER "${windows_directory}/" lower_windows)
                string(FIND "${lower_image}" "${lower_windows}" position)
                if(NOT position EQUAL 0)
                    bloom_fail("${who} loaded ${image}, which is neither in the package nor part "
                               "of Windows")
                elseif(leaf MATCHES "^(vcruntime|msvcp|concrt|vcomp)[0-9]")
                    bloom_fail("${who} loaded the Visual C++ runtime from Windows (${image}), not "
                               "from the package")
                endif()
            else()
                list(APPEND outside "${who}|${image}")
            endif()
        endif()
    endforeach()
    foreach(step IN ITEMS cli application)
        if(NOT step IN_LIST finished)
            list(APPEND failures "the run did not report what ${step} loaded")
        endif()
    endforeach()

    if(system STREQUAL "linux" AND outside)
        # A file from outside is accepted when it is a declared system library, or when a file
        # already accepted asked the loader for it (the system's own library loading the
        # system's own). Who asked for what is the loader's own record (LD_DEBUG=files): "needed
        # by" for a library a file names, "dynamically loaded by" for one it opens while running.
        set(edges "")
        foreach(record IN LISTS records_read)
            if(NOT record MATCHES "^process [a-z]+ ([0-9]+)$")
                continue()
            endif()
            set(log "${WORK}/loader/log.${CMAKE_MATCH_1}")
            if(NOT EXISTS "${log}")
                list(APPEND failures "the loader left no record of process ${CMAKE_MATCH_1}")
                continue()
            endif()
            file(STRINGS "${log}" lines REGEX "file=.*(needed|dynamically loaded) by ")
            foreach(line IN LISTS lines)
                if(line MATCHES
                   "file=([^ ]+) \\[[0-9]+\\];  (needed|dynamically loaded) by ([^ ]+) \\[")
                    get_filename_component(asked "${CMAKE_MATCH_1}" NAME)
                    set(asker "${CMAKE_MATCH_3}")
                    if(EXISTS "${asker}")
                        file(REAL_PATH "${asker}" asker)
                    endif()
                    list(APPEND edges "${asker}|${asked}")
                endif()
            endforeach()
        endforeach()
        list(REMOVE_DUPLICATES edges)

        list(REMOVE_DUPLICATES outside)
        set(accepted "")
        set(waiting "")
        foreach(entry IN LISTS outside)
            string(REGEX REPLACE "^[^|]+\\|" "" image "${entry}")
            bloom_base_file("${image}" base)
            if(base)
                list(APPEND accepted "${image}")
            else()
                list(APPEND waiting "${image}")
            endif()
        endforeach()
        list(REMOVE_DUPLICATES accepted)
        list(REMOVE_DUPLICATES waiting)
        set(changed TRUE)
        while(changed AND waiting)
            set(changed FALSE)
            foreach(edge IN LISTS edges)
                string(REGEX MATCH "^(.*)\\|([^|]+)$" matched "${edge}")
                set(asker "${CMAKE_MATCH_1}")
                set(asked "${CMAKE_MATCH_2}")
                if(NOT asker IN_LIST accepted)
                    continue()
                endif()
                foreach(image IN LISTS waiting)
                    get_filename_component(leaf "${image}" NAME)
                    bloom_file_is("${leaf}" "${asked}" is)
                    if(is)
                        list(APPEND accepted "${image}")
                        list(REMOVE_ITEM waiting "${image}")
                        set(changed TRUE)
                    endif()
                endforeach()
            endforeach()
        endwhile()
        # What a file of the package itself asked for must be a declared system library by
        # name when it comes from outside: that the machine's own libraries happen to load it
        # too says nothing about another machine.
        foreach(edge IN LISTS edges)
            string(REGEX MATCH "^(.*)\\|([^|]+)$" matched "${edge}")
            set(asker "${CMAKE_MATCH_1}")
            set(asked "${CMAKE_MATCH_2}")
            bloom_inside("${asker}" inside)
            if(NOT inside)
                continue()
            endif()
            foreach(image IN LISTS accepted)
                get_filename_component(leaf "${image}" NAME)
                bloom_file_is("${leaf}" "${asked}" is)
                if(NOT is)
                    continue()
                endif()
                bloom_base_file("${image}" base)
                if(NOT base)
                    bloom_shown("${asker}" shown)
                    bloom_fail("${image} was loaded from outside the package for ${shown}, "
                               "which is not a declared system library")
                endif()
            endforeach()
        endforeach()
        # What is left was asked for by the package itself, or by a file that was. Only the
        # first kind is reported: the rest follows from it.
        foreach(image IN LISTS waiting)
            get_filename_component(leaf "${image}" NAME)
            set(askers "")
            set(known FALSE)
            foreach(edge IN LISTS edges)
                string(REGEX MATCH "^(.*)\\|([^|]+)$" matched "${edge}")
                bloom_file_is("${leaf}" "${CMAKE_MATCH_2}" is)
                if(NOT is)
                    continue()
                endif()
                set(known TRUE)
                bloom_inside("${CMAKE_MATCH_1}" inside)
                if(inside)
                    bloom_shown("${CMAKE_MATCH_1}" shown)
                    list(APPEND askers "${shown}")
                endif()
            endforeach()
            if(askers)
                list(REMOVE_DUPLICATES askers)
                list(JOIN askers ", " askers)
                bloom_fail("${image} was loaded from outside the package for ${askers}, "
                           "which is not "
                           "a declared system library")
            elseif(NOT known)
                bloom_fail("${image} was loaded from outside the package and the loader does not "
                           "say for what")
            endif()
        endforeach()
    endif()
endif()

if(failures)
    list(REMOVE_DUPLICATES failures)
    list(JOIN failures "\n  " text)
    message(FATAL_ERROR "${package_name} is not self-contained:\n  ${text}")
endif()
set(summary "${package_name}: ${count} programs and libraries resolve inside the package or ")
string(APPEND summary "the operating system")
if(image_count GREATER 0)
    string(APPEND summary ", and the ${image_count} images a run loaded came from the same places")
endif()
message(STATUS "${summary}")
