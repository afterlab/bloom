<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Merged into every Bloom executable on Windows, test programs included.
  activeCodePage: the process's narrow-string code page is UTF-8 (Windows 10 version 1903 and
  later), so std::filesystem::path(std::string), path::string(), the C runtime's file calls and
  every third-party library that opens a narrow path all agree with Bloom's UTF-8 strings.
  longPathAware: paths longer than 260 characters are accepted where the system allows them.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
