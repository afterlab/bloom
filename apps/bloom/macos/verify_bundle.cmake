# Checks that a deployed Bloom.app needs nothing but itself and the operating system.
#
#   cmake -DBUNDLE=<path to Bloom.app> [-DREQUIRE_PYTHON=ON] -P verify_bundle.cmake
#
# Every program and library in the bundle is read with otool. The check fails when
#
#   * a library one of them loads is neither inside the bundle nor part of the operating system
#     (/usr/lib, /System), or is named through a search path that leads nowhere in the bundle;
#   * one of them carries a library search path that points outside the bundle;
#   * one of them was built for a newer system than the bundle's LSMinimumSystemVersion, or
#     states no minimum system;
#   * REQUIRE_PYTHON is set and the bundle has no interpreter, standard library, Bloom package or
#     license texts for them.
#
# macdeployqt reports a library it cannot find and still succeeds; this is what stops the deploy.
# A bundle that passes starts on a Mac that has none of the build machine's software.

# file(REAL_PATH) follows links before it collapses "..", as the loader does.
if(POLICY CMP0152)
    cmake_policy(SET CMP0152 NEW)
endif()

if(NOT BUNDLE OR NOT IS_DIRECTORY "${BUNDLE}")
    message(FATAL_ERROR "verify_bundle.cmake: BUNDLE is not a directory: '${BUNDLE}'")
endif()
file(REAL_PATH "${BUNDLE}" bundle)
set(contents "${bundle}/Contents")
set(failures "")

function(bloom_plist key variable)
    execute_process(COMMAND /usr/libexec/PlistBuddy -c "Print ${key}" "${contents}/Info.plist"
                    OUTPUT_VARIABLE value OUTPUT_STRIP_TRAILING_WHITESPACE
                    RESULT_VARIABLE result ERROR_QUIET)
    if(NOT result EQUAL 0)
        set(value "")
    endif()
    set(${variable} "${value}" PARENT_SCOPE)
endfunction()

bloom_plist(LSMinimumSystemVersion minimum)
bloom_plist(CFBundleExecutable main_name)
if(NOT minimum)
    list(APPEND failures "Info.plist has no LSMinimumSystemVersion")
endif()
set(main_directory "${contents}/MacOS")
if(NOT main_name OR NOT EXISTS "${main_directory}/${main_name}")
    list(APPEND failures "the bundle's executable is missing: '${main_name}'")
endif()

# Sets ${variable} to the lines of otool's output for one file.
function(bloom_otool variable)
    execute_process(COMMAND otool ${ARGN} OUTPUT_VARIABLE output RESULT_VARIABLE result
                    ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "otool ${ARGN} failed: ${error}")
    endif()
    string(REPLACE ";" "\;" output "${output}")
    string(REPLACE "\n" ";" output "${output}")
    set(${variable} "${output}" PARENT_SCOPE)
endfunction()

# Every Mach-O file, by its first four bytes. Per file: what it loads, its search paths, the
# systems it was built for, and whether it is a program.
set(load_commands LC_LOAD_DYLIB LC_LOAD_WEAK_DYLIB LC_REEXPORT_DYLIB LC_LAZY_LOAD_DYLIB)
file(GLOB_RECURSE files LIST_DIRECTORIES false "${contents}/*")
set(binaries "")
set(programs "")
set(count 0)
foreach(file IN LISTS files)
    if(IS_SYMLINK "${file}")
        continue()
    endif()
    file(READ "${file}" magic LIMIT 4 HEX)
    if(NOT magic MATCHES "^(cffaedfe|cefaedfe|feedfacf|feedface|cafebabe|cafebabf)$")
        continue()
    endif()
    set(index ${count})
    math(EXPR count "${count} + 1")
    list(APPEND binaries ${index})
    set(path_${index} "${file}")
    set(loads_${index} "")
    set(search_${index} "")
    set(systems_${index} "")
    bloom_otool(header -hv "${file}")
    if(header MATCHES " EXECUTE ")
        set(program_${index} TRUE)
        list(APPEND programs ${index})
    else()
        set(program_${index} FALSE)
    endif()
    bloom_otool(lines -l "${file}")
    set(command "")
    foreach(line IN LISTS lines)
        string(STRIP "${line}" line)
        if(line MATCHES "^cmd ([A-Z_0-9]+)")
            set(command "${CMAKE_MATCH_1}")
        elseif(command IN_LIST load_commands AND line MATCHES "^name (.+) \\(offset [0-9]+\\)$")
            list(APPEND loads_${index} "${CMAKE_MATCH_1}")
        elseif(command STREQUAL "LC_RPATH" AND line MATCHES "^path (.+) \\(offset [0-9]+\\)$")
            list(APPEND search_${index} "${CMAKE_MATCH_1}")
        elseif(command STREQUAL "LC_BUILD_VERSION" AND line MATCHES "^minos ([0-9.]+)")
            list(APPEND systems_${index} "${CMAKE_MATCH_1}")
        elseif(command STREQUAL "LC_VERSION_MIN_MACOSX" AND line MATCHES "^version ([0-9.]+)")
            list(APPEND systems_${index} "${CMAKE_MATCH_1}")
        endif()
    endforeach()
endforeach()

# A load or search path with @loader_path and @executable_path filled in; empty when it is
# neither those nor absolute.
function(bloom_expand text loader program_directory variable)
    get_filename_component(loader_directory "${loader}" DIRECTORY)
    if(text MATCHES "^@loader_path(.*)$")
        set(result "${loader_directory}${CMAKE_MATCH_1}")
    elseif(text MATCHES "^@executable_path(.*)$")
        set(result "${program_directory}${CMAKE_MATCH_1}")
    elseif(text MATCHES "^/")
        set(result "${text}")
    else()
        set(result "")
    endif()
    set(${variable} "${result}" PARENT_SCOPE)
endfunction()

# TRUE when the path, links followed, is inside the bundle. For a file it must exist.
function(bloom_inside path must_be_file variable)
    set(${variable} FALSE PARENT_SCOPE)
    if(path STREQUAL "")
        return()
    endif()
    if(must_be_file AND (NOT EXISTS "${path}" OR IS_DIRECTORY "${path}"))
        return()
    endif()
    # A search path may name a directory that does not exist; it is then judged by where it
    # would be.
    if(EXISTS "${path}")
        file(REAL_PATH "${path}" real)
    else()
        cmake_path(SET real NORMALIZE "${path}")
    endif()
    cmake_path(IS_PREFIX bundle "${real}" NORMALIZE inside)
    set(${variable} ${inside} PARENT_SCOPE)
endfunction()

# The directories a binary's @rpath loads are looked up in. A search path is read relative to the
# program that is running: a program uses its own; a library is loaded by the bundle's programs,
# so its own search paths are tried for each of them and so are each program's.
function(bloom_search_directories index variable)
    set(directories "")
    if(program_${index})
        set(owners ${index})
    else()
        set(owners ${index} ${programs})
    endif()
    foreach(owner IN LISTS owners)
        if(program_${owner})
            get_filename_component(program_directories "${path_${owner}}" DIRECTORY)
        else()
            set(program_directories "")
            foreach(program IN LISTS programs)
                get_filename_component(directory "${path_${program}}" DIRECTORY)
                list(APPEND program_directories "${directory}")
            endforeach()
            list(REMOVE_DUPLICATES program_directories)
        endif()
        foreach(text IN LISTS search_${owner})
            foreach(program_directory IN LISTS program_directories)
                bloom_expand("${text}" "${path_${owner}}" "${program_directory}" directory)
                if(directory)
                    list(APPEND directories "${directory}")
                endif()
            endforeach()
        endforeach()
    endforeach()
    list(REMOVE_DUPLICATES directories)
    set(${variable} "${directories}" PARENT_SCOPE)
endfunction()

foreach(index IN LISTS binaries)
    file(RELATIVE_PATH name "${bundle}" "${path_${index}}")
    if(program_${index})
        get_filename_component(program_directory "${path_${index}}" DIRECTORY)
    else()
        set(program_directory "${main_directory}")
    endif()
    foreach(text IN LISTS search_${index})
        if(text MATCHES "^(/usr/lib/|/System/)")
            continue()
        endif()
        bloom_expand("${text}" "${path_${index}}" "${program_directory}" directory)
        bloom_inside("${directory}" FALSE inside)
        if(NOT inside)
            list(APPEND failures "${name}: library search path outside the bundle: ${text}")
        endif()
    endforeach()
    foreach(load IN LISTS loads_${index})
        if(load MATCHES "^(/usr/lib/|/System/)")
            continue()
        endif()
        set(found FALSE)
        if(load MATCHES "^@rpath/(.+)$")
            set(leaf "${CMAKE_MATCH_1}")
            bloom_search_directories(${index} directories)
            foreach(directory IN LISTS directories)
                bloom_inside("${directory}/${leaf}" TRUE found)
                if(found)
                    break()
                endif()
            endforeach()
        else()
            bloom_expand("${load}" "${path_${index}}" "${program_directory}" target)
            bloom_inside("${target}" TRUE found)
        endif()
        if(NOT found)
            list(APPEND failures "${name}: loads ${load}, which is not in the bundle")
        endif()
    endforeach()
    if(NOT systems_${index})
        list(APPEND failures "${name}: states no minimum system version")
    elseif(minimum)
        foreach(system IN LISTS systems_${index})
            if(system VERSION_GREATER minimum)
                list(APPEND failures
                     "${name}: built for macOS ${system}, the bundle declares ${minimum}")
            endif()
        endforeach()
    endif()
endforeach()

if(REQUIRE_PYTHON)
    set(home "${contents}/Resources/python")
    file(GLOB libraries "${home}/lib/python3.*")
    list(LENGTH libraries library_count)
    if(NOT library_count EQUAL 1 OR NOT EXISTS "${libraries}/os.py")
        list(APPEND failures "Contents/Resources/python holds no standard library")
    else()
        get_filename_component(version "${libraries}" NAME)
        if(NOT EXISTS "${contents}/Frameworks/lib${version}.dylib")
            list(APPEND failures "Contents/Frameworks has no lib${version}.dylib")
        endif()
        file(GLOB ssl "${libraries}/lib-dynload/_ssl.*.so")
        if(NOT ssl)
            list(APPEND failures "the bundled standard library has no ssl module")
        endif()
    endif()
    if(NOT EXISTS "${contents}/Resources/bloom-python/bloom/__init__.py")
        list(APPEND failures "Contents/Resources/bloom-python holds no Bloom package")
    endif()
    foreach(component IN ITEMS python openssl xz zstd expat)
        file(GLOB texts "${home}/licenses/${component}/*")
        if(NOT texts)
            list(APPEND failures "no license text for ${component} in the bundle")
        endif()
    endforeach()
endif()

get_filename_component(bundle_name "${bundle}" NAME)
if(failures)
    list(JOIN failures "\n  " text)
    message(FATAL_ERROR "${bundle_name} is not self-contained:\n  ${text}")
endif()
message(STATUS "${bundle_name}: ${count} programs and libraries resolve inside the bundle or the "
               "operating system; none needs more than macOS ${minimum}")
